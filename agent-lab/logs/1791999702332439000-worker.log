     1  """
     2  Experiment 005: timeit number=N optimization study.
     3  
     4  Hypothesis (from experiment_004):
     5    Using timeit with number=N (multiple calls per repeat) will reduce CV for
     6    fast operations by amortizing timer overhead. CV should decrease as N
     7    increases (amortizing timer overhead), then plateau or increase (system
     8    noise dominates).
     9  
    10  Design:
    11  - Timer: timeit module with varying number=N
    12  - Sizes: 32, 128, 512 (all three from original task)
    13  - Input types: random, sorted, reverse, duplicates (all four)
    14  - number values: 1, 10, 100, 1000
    15  - reps (timeit repeat count): 200 per (size, input_type, algorithm, number)
    16  - Deterministic seeds (same as experiment_001)
    17  - Correctness verified on every measured input
    18  - Copying NOT timed (copy happens inside the timed lambda)
    19  - Randomization: measurement order randomized (seed 12345)
    20  """
    21  import csv
    22  import os
    23  import platform
    24  import random
    25  import sys
    26  import time
    27  import timeit
    28  from collections import defaultdict
    29  
    30  
    31  # ---------------------------------------------------------------------------
    32  # Algorithms
    33  # ---------------------------------------------------------------------------
    34  
    35  def insertion_sort(arr):
    36      """Pure-Python insertion sort. Returns a new sorted list."""
    37      a = list(arr)
    38      n = len(a)
    39      for i in range(1, n):
    40          key = a[i]
    41          j = i - 1
    42          while j >= 0 and a[j] > key:
    43              a[j + 1] = a[j]
    44              j -= 1
    45          a[j + 1] = key
    46      return a
    47  
    48  
    49  # ---------------------------------------------------------------------------
    50  # Input generation
    51  # ---------------------------------------------------------------------------
    52  
    53  def generate_input(itype, size, seed):
    54      """Generate a list of integers. Returns the list."""
    55      rng = random.Random(seed)
    56      if itype == "random":
    57          return [rng.randint(-1000, 1000) for _ in range(size)]
    58      elif itype == "sorted":
    59          return sorted([rng.randint(-1000, 1000) for _ in range(size)])
    60      elif itype == "reverse":
    61          return sorted([rng.randint(-1000, 1000) for _ in range(size)], reverse=True)
    62      elif itype == "duplicates":
    63          return [rng.randint(0, 3) for _ in range(size)]
    64      else:
    65          raise ValueError(f"Unknown input type: {itype}")
    66  
    67  
    68  # ---------------------------------------------------------------------------
    69  # Benchmarking
    70  # ---------------------------------------------------------------------------
    71  
    72  def benchmark_timeit_number(algo_fn, data, number, reps):
    73      """Run reps measurements using timeit with number=N calls per repeat.
    74      Returns list of total times (in seconds) for each repeat."""
    75      timer = timeit.default_timer
    76      times = timeit.repeat(
    77          stmt=lambda: algo_fn(list(data)),
    78          setup=lambda: None,
    79          number=number,
    80          repeat=reps,
    81          timer=timer,
    82      )
    83      return times
    84  
    85  
    86  def run_benchmark():
    87      # Platform info
    88      info = {
    89          "python_version": platform.python_version(),
    90          "python_implementation": platform.python_implementation(),
    91          "platform": platform.platform(),
    92          "machine": platform.machine(),
    93          "processor": platform.processor(),
    94      }
    95      print("Platform information:")
    96      for k, v in info.items():
    97          print(f"  {k}: {v}")
    98      print()
    99  
   100      # Parameters
   101      sizes = [32, 128, 512]
   102      input_types = ["random", "sorted", "reverse", "duplicates"]
   103      seeds = {"random": 42, "sorted": 1, "reverse": 1, "duplicates": 99}
   104      reps = 30  # timeit repeat count per condition (minimum required)
   105  
   106      # number=N values: full range for builtin_sorted (fast, timer overhead matters),
   107      # reduced range for insertion_sort (slow, N=1000 would take too long)
   108      numbers_builtin = [1, 10, 100, 1000]
   109      numbers_insert = [1, 10, 100]
   110  
   111      # Build all conditions
   112      conditions = []
   113      for size in sizes:
   114          for itype in input_types:
   115              seed = seeds[itype]
   116              data = generate_input(itype, size, seed)
   117              conditions.append((size, itype, seed, data))
   118  
   119      # Randomize measurement order
   120      rng_order = random.Random(12345)
   121      condition_indices = list(range(len(conditions)))
   122      rng_order.shuffle(condition_indices)
   123  
   124      algo_map = {
   125          "builtin_sorted": sorted,
   126          "insertion_sort": insertion_sort,
   127      }
   128  
   129      # Run measurements
   130      total = len(conditions) * (len(numbers_builtin) + len(numbers_insert))
   131      print(f"Running {reps} timeit repeats per condition...")
   132      print(f"Conditions: {len(conditions)}")
   133      print(f"  builtin_sorted: {len(numbers_builtin)} number values")
   134      print(f"  insertion_sort: {len(numbers_insert)} number values")
   135      print(f"Total measurements: {total * reps}")
   136      print()
   137  
   138      all_rows = []
   139  
   140      for idx in condition_indices:
   141          size, itype, seed, data = conditions[idx]
   142  
   143          # Verify correctness before timing
   144          expected = sorted(data)
   145          for algo_name in algo_map:
   146              test_data = list(data)
   147              result = algo_map[algo_name](test_data)
   148              if result != expected:
   149                  print(f"ERROR: {algo_name} failed correctness on size={size} type={itype}")
   150                  sys.exit(1)
   151  
   152          # builtin_sorted: full N range
   153          for number in numbers_builtin:
   154              times = benchmark_timeit_number(algo_map["builtin_sorted"], data, number, reps)
   155              for i, t in enumerate(times):
   156                  per_call = t / number
   157                  all_rows.append({
   158                      "size": size,
   159                      "input_type": itype,
   160                      "seed": seed,
   161                      "algorithm": "builtin_sorted",
   162                      "number": number,
   163                      "repetition": i,
   164                      "time_seconds": per_call,
   165                      "time_microseconds": per_call * 1e6,
   166                  })
   167  
   168          # insertion_sort: reduced N range
   169          for number in numbers_insert:
   170              times = benchmark_timeit_number(algo_map["insertion_sort"], data, number, reps)
   171              for i, t in enumerate(times):
   172                  per_call = t / number
   173                  all_rows.append({
   174                      "size": size,
   175                      "input_type": itype,
   176                      "seed": seed,
   177                      "algorithm": "insertion_sort",
   178                      "number": number,
   179                      "repetition": i,
   180                      "time_seconds": per_call,
   181                      "time_microseconds": per_call * 1e6,
   182                  })
   183  
   184      # Write raw CSV
   185      csv_path = os.path.join(os.path.dirname(__file__), "measurements.csv")
   186      fieldnames = list(all_rows[0].keys())
   187      with open(csv_path, "w", newline="") as f:
   188          writer = csv.DictWriter(f, fieldnames=fieldnames)
   189          writer.writeheader()
   190          writer.writerows(all_rows)
   191      print(f"Raw measurements written to: {csv_path}")
   192      print(f"  Rows: {len(all_rows)}")
   193      print(f"  File size: {os.path.getsize(csv_path)} bytes")
   194      print()
   195  
   196      # Summary statistics
   197      print("=" * 100)
   198      print("SUMMARY STATISTICS (microseconds per call) — timeit module")
   199      print("=" * 100)
   200  
   201      # Group by (size, input_type, algorithm, number)
   202      groups = defaultdict(list)
   203      for row in all_rows:
   204          key = (row["size"], row["input_type"], row["algorithm"], row["number"])
   205          groups[key].append(row["time_microseconds"])
   206  
   207      # Collect all unique N values per algorithm
   208      all_numbers_builtin = sorted(set(r["number"] for r in all_rows if r["algorithm"] == "builtin_sorted"))
   209      all_numbers_insert = sorted(set(r["number"] for r in all_rows if r["algorithm"] == "insertion_sort"))
   210  
   211      # Print per-condition summary
   212      print()
   213      print("--- Per-condition summary (mean ± std, CV%) ---")
   214      for size in sizes:
   215          for itype in input_types:
   216              for number in all_numbers_builtin:
   217                  key = (size, itype, "builtin_sorted", number)
   218                  if key in groups:
   219                      times = groups[key]
   220                      mean = sum(times) / len(times)
   221                      std = (sum((x - mean) ** 2 for x in times) / len(times)) ** 0.5
   222                      cv = std / mean * 100 if mean > 0 else 0
   223                      print(
   224                          f"  size={size:3d} {itype:15s} {'builtin_sorted':15s} N={number:4d}: "
   225                          f"{mean:8.2f} ± {std:6.2f} ({cv:5.1f}%)"
   226                      )
   227              for number in all_numbers_insert:
   228                  key = (size, itype, "insertion_sort", number)
   229                  if key in groups:
   230                      times = groups[key]
   231                      mean = sum(times) / len(times)
   232                      std = (sum((x - mean) ** 2 for x in times) / len(times)) ** 0.5
   233                      cv = std / mean * 100 if mean > 0 else 0
   234                      print(
   235                          f"  size={size:3d} {itype:15s} {'insertion_sort':15s} N={number:4d}: "
   236                          f"{mean:8.2f} ± {std:6.2f} ({cv:5.1f}%)"
   237                      )
   238  
   239      # CV analysis: how CV changes with N
   240      print()
   241      print("=" * 100)
   242      print("CV ANALYSIS: How CV changes with number=N")
   243      print("=" * 100)
   244      print()
   245      print("Focus: builtin_sorted (fastest, most affected by timer overhead)")
   246      print()
   247  
   248      for size in sizes:
   249          for itype in input_types:
   250              print(f"  size={size} {itype:15s}:")
   251              for number in all_numbers_builtin:
   252                  key = (size, itype, "builtin_sorted", number)
