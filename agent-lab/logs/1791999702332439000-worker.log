   257                      cv = std / mean * 100 if mean > 0 else 0
   258                      print(f"    N={number:4d}: mean={mean:8.2f} μs  std={std:6.2f}  CV={cv:5.1f}%")
   259              print()
   260  
   261      # Find optimal N for each size (minimum CV for builtin_sorted)
   262      print("=" * 100)
   263      print("OPTIMAL N (minimum CV for builtin_sorted)")
   264      print("=" * 100)
   265      print()
   266  
   267      for size in sizes:
   268          best_cv = float("inf")
   269          best_n = None
   270          for itype in input_types:
   271              for number in all_numbers_builtin:
   272                  key = (size, itype, "builtin_sorted", number)
