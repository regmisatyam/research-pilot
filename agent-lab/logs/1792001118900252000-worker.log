                        "size": size,
                        "disorder_pct": dpct,
                        "algorithm": algo_name,
                        "repetition": i,
                        "time_seconds": t,
                        "time_microseconds": t * 1e6,
                    })
    
        # Write raw CSV
        csv_path = os.path.join(os.path.dirname(__file__), "measurements.csv")
