        sizes = [32, 128, 512]
        disorder_levels = [0, 10, 25, 50, 75, 100]
        reps = 50
    
        print(f"Hypothesis: Partially sorted insertion sort scales linearly with disorder.")
        print(f"Disorder levels: {disorder_levels}%")
        print(f"Sizes: {sizes}")
        print(f"Repetitions: {reps}")
