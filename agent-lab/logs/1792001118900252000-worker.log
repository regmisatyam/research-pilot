     1  """
     2  Correctness tests for sorted() and insertion_sort().
     3  Tests edge cases: empty list, singleton, negatives, duplicates,
     4  and all measured input types at sizes 32, 128, 512.
     5  """
     6  import random
     7  import sys
     8  
     9  
    10  def insertion_sort(arr):
    11      """Pure-Python insertion sort. Returns a new sorted list."""
    12      a = list(arr)  # work on a copy
    13      n = len(a)
    14      for i in range(1, n):
    15          key = a[i]
    16          j = i - 1
    17          while j >= 0 and a[j] > key:
    18              a[j + 1] = a[j]
    19              j -= 1
    20          a[j + 1] = key
    21      return a
    22  
    23  
    24  def run_tests():
    25      results = []
    26      all_pass = True
    27  
    28      # --- Edge case tests ---
    29      edge_cases = [
    30          ("empty list", []),
    31          ("singleton", [42]),
    32          ("negatives only", [-5, -1, -3, -2, -4]),
    33          ("mixed pos/neg", [3, -1, 0, 5, -2, 4]),
    34          ("all duplicates", [7, 7, 7, 7, 7]),
    35          ("already sorted", [1, 2, 3, 4, 5]),
    36          ("reverse sorted", [5, 4, 3, 2, 1]),
    37      ]
    38  
    39      print("=" * 60)
    40      print("CORRECTNESS TESTS")
    41      print("=" * 60)
    42  
    43      for name, data in edge_cases:
    44          builtin_result = sorted(data)
    45          insert_result = insertion_sort(data)
    46          builtin_ok = builtin_result == sorted(data)
    47          insert_ok = insert_result == builtin_result
    48          status = "PASS" if insert_ok else "FAIL"
    49          if not insert_ok:
    50              all_pass = False
    51          results.append(("edge", name, "builtin", builtin_ok))
    52          results.append(("edge", name, "insertion", insert_ok))
    53          print(f"  {name:25s} builtin={status:4s} insertion={status:4s}")
    54  
    55      # --- Measured input tests (sizes 32, 128, 512; types: random, sorted, reverse, duplicates) ---
    56      sizes = [32, 128, 512]
    57      input_types = ["random", "sorted", "reverse", "duplicates"]
    58      seeds = {
    59          "random": 42,
    60          "sorted": 1,
    61          "reverse": 1,
    62          "duplicates": 99,
    63      }
    64  
    65      for size in sizes:
    66          for itype in input_types:
    67              seed = seeds[itype]
    68              rng = random.Random(seed)
    69  
    70              if itype == "random":
    71                  data = [rng.randint(-1000, 1000) for _ in range(size)]
    72              elif itype == "sorted":
    73                  data = sorted([rng.randint(-1000, 1000) for _ in range(size)])
    74              elif itype == "reverse":
    75                  data = sorted([rng.randint(-1000, 1000) for _ in range(size)], reverse=True)
    76              elif itype == "duplicates":
    77                  data = [rng.randint(0, 3) for _ in range(size)]  # only 4 distinct values
    78  
    79              builtin_result = sorted(data)
    80              insert_result = insertion_sort(data)
    81              insert_ok = insert_result == builtin_result
    82              status = "PASS" if insert_ok else "FAIL"
    83              if not insert_ok:
    84                  all_pass = False
    85              print(f"  size={size:3d} {itype:15s} insertion={status:4s}  (seed={seed})")
    86  
    87      print()
    88      print("=" * 60)
    89      if all_pass:
    90          print("ALL CORRECTNESS TESTS PASSED")
    91      else:
    92          print("SOME CORRECTNESS TESTS FAILED")
    93      print("=" * 60)
    94  
    95      return all_pass
    96  
    97  
    98  if __name__ == "__main__":
    99      ok = run_tests()
   100      sys.exit(0 if ok else 1)


