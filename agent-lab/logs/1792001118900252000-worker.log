        for size in sizes:
            print(f"\n  Size = {size}")
            print(f"  {'Disorder':>10s}  {'Builtin':>10s}  {'Insertion':>10s}  {'Ratio':>8s}  {'B-CV':>6s}  {'I-CV':>6s}")
