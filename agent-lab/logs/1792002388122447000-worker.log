   148      rng_order = random.Random(12345)
   149      condition_indices = list(range(len(conditions)))
   150      rng_order.shuffle(condition_indices)
   151  
   152      print(f"Running {reps} repetitions per condition...")
   153      print(f"Total conditions: {len(conditions)} x 2 algorithms x 3 GC modes = {len(conditions) * 6}")
   154      print(f"Total measurements: {len(conditions) * 6 * reps}")
   155      print()
   156  
   157      all_rows = []
