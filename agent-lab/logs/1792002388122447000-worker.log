   189                          "gc_mode": gc_mode,
   190                          "repetition": i,
   191                          "time_seconds": t,
   192                          "time_microseconds": t * 1e6,
   193                      })
   194  
   195      # Write raw CSV
   196      csv_path = os.path.join(os.path.dirname(__file__), "measurements.csv")
   197      fieldnames = list(all_rows[0].keys())
   198      with open(csv_path, "w", newline="") as f:
   199          writer = csv.DictWriter(f, fieldnames=fieldnames)
   200          writer.writeheader()
   201          writer.writerows(all_rows)
   202      print(f"Raw measurements written to: {csv_path}")
   203      print(f"  Rows: {len(all_rows)}")
   204      print(f"  File size: {os.path.getsize(csv_path)} bytes")
   205      print()
   206  
   207      # Summary statistics
   208      print("=" * 80)
   209      print("SUMMARY STATISTICS (microseconds)")
   210      print("=" * 80)
   211  
   212      groups = defaultdict(list)
   213      for row in all_rows:
   214          key = (row["size"], row["input_type"], row["algorithm"], row["gc_mode"])
   215          groups[key].append(row["time_microseconds"])
   216  
   217      for size in sizes:
   218          for itype in input_types:
   219              print(f"\n  Size={size}, Input={itype}")
   220              print(f"  {'GC Mode':>12s}  {'Algo':>15s}  {'Mean':>8s}  {'Median':>8s}  {'Std':>8s}  {'CV':>6s}  {'Min':>8s}  {'Max':>8s}  {'Outliers':>10s}")
   221              for algo_name in ["builtin_sorted", "insertion_sort"]:
   222                  for gc_mode in ["disabled", "enabled", "collect"]:
   223                      key = (size, itype, algo_name, gc_mode)
   224                      if key in groups:
   225                          times = groups[key]
   226                          mean_t = sum(times) / len(times)
   227                          sorted_t = sorted(times)
   228                          median_t = sorted_t[len(sorted_t) // 2]
   229                          std_t = (sum((x - mean_t) ** 2 for x in times) / len(times)) ** 0.5
   230                          cv_t = (std_t / mean_t * 100) if mean_t > 0 else 0
   231                          min_t = sorted_t[0]
   232                          max_t = sorted_t[-1]
   233                          # Outliers: values > 3× the median
   234                          iqr = sorted_t[int(len(sorted_t) * 0.75)] - sorted_t[int(len(sorted_t) * 0.25)]
   235                          upper_fence = sorted_t[int(len(sorted_t) * 0.75)] + 3 * iqr
   236                          outlier_count = sum(1 for t in times if t > upper_fence)
   237                          print(f"  {gc_mode:>12s}  {algo_name:>15s}  {mean_t:>8.2f}  {median_t:>8.2f}  {std_t:>8.2f}  {cv_t:>5.1f}%  {min_t:>8.2f}  {max_t:>8.2f}  {outlier_count:>10d}")
   238  
   239      print()
