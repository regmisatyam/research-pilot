     1  """
     2  Experiment 009: GC Pause Investigation — Outlier Analysis in Builtin Sorted Timing
     3  
     4  Hypothesis:
     5    The extreme outliers in builtin_sorted timing (CV=140% at size=32, 10% disorder)
     6    are caused by garbage collection pauses. When gc.collect() is called implicitly
     7    during memory allocation, it adds 5–20 μs of overhead, creating outliers.
     8  
     9    Prediction:
    10    - With gc.disable(), outlier rate drops to near zero
    11    - With gc.enable() (default), outlier rate matches experiment_008
    12    - Explicit gc.collect() before each measurement eliminates outliers but adds
    13      systematic overhead (~14–31 μs per call, per experiment_007)
    14  
    15  Design:
    16    - Sizes: 32, 128, 512
    17    - Input types: sorted, 10% disorder, random (the three most interesting)
    18    - GC modes: disabled, enabled (default), explicit collect before each call
    19    - Repetitions: 200 per condition (high count to detect rare outliers)
    20    - Timer: time.perf_counter()
    21    - Copying: NOT timed
    22    - Seeds: sorted=1, disorder=42, random=42
    23    - Python: 3.13.15 / aarch64 Linux
    24  """
    25  import csv
    26  import gc
    27  import os
    28  import platform
    29  import random
    30  import sys
    31  import time
    32  from collections import defaultdict
    33  
    34  
    35  def insertion_sort(arr):
    36      """Pure-Python insertion sort. Returns a new sorted list."""
    37      a = list(arr)
    38      n = len(a)
    39      for i in range(1, n):
    40          key = a[i]
    41          j = i - 1
    42          while j >= 0 and a[j] > key:
    43              a[j + 1] = a[j]
    44              j -= 1
    45      return a
    46  
    47  
    48  def generate_sorted(size, seed):
    49      rng = random.Random(seed)
    50      return sorted([rng.randint(-1000, 1000) for _ in range(size)])
    51  
    52  
    53  def generate_partially_sorted(size, disorder_pct, seed):
    54      rng = random.Random(seed)
    55      data = list(range(size))
    56      k = int(size * disorder_pct / 100.0)
    57      if k > 0:
    58          indices = list(range(size))
    59          rng.shuffle(indices)
    60          for i in range(k):
    61              idx_a = indices[i]
    62              idx_b = indices[rng.randint(0, size - 1)]
    63              data[idx_a], data[idx_b] = data[idx_b], data[idx_a]
    64      return data
    65  
    66  
    67  def generate_random(size, seed):
    68      rng = random.Random(seed)
    69      return [rng.randint(-1000, 1000) for _ in range(size)]
    70  
    71  
    72  def benchmark_one_gc_disabled(algo, data, reps):
    73      """Benchmark with gc disabled."""
    74      gc.disable()
    75      times = []
    76      for _ in range(reps):
    77          data_copy = list(data)
    78          start = time.perf_counter()
    79          result = algo(data_copy)
    80          end = time.perf_counter()
    81          times.append(end - start)
    82      gc.enable()
    83      return times
    84  
    85  
    86  def benchmark_one_gc_enabled(algo, data, reps):
    87      """Benchmark with gc enabled (default)."""
    88      times = []
    89      for _ in range(reps):
    90          data_copy = list(data)
    91          start = time.perf_counter()
    92          result = algo(data_copy)
    93          end = time.perf_counter()
    94          times.append(end - start)
    95      return times
    96  
    97  
    98  def benchmark_one_gc_collect(algo, data, reps):
    99      """Benchmark with explicit gc.collect() before each measurement."""
   100      times = []
   101      for _ in range(reps):
   102          gc.collect()
   103          data_copy = list(data)
   104          start = time.perf_counter()
   105          result = algo(data_copy)
   106          end = time.perf_counter()
   107          times.append(end - start)
   108      return times
   109  
