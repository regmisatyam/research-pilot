   181                  elif gc_mode == "collect":
   182                      times = benchmark_one_gc_collect(algo_map[algo_name], data, reps)
   183  
   184                  for i, t in enumerate(times):
   185                      all_rows.append({
   186                          "size": size,
   187                          "input_type": itype,
