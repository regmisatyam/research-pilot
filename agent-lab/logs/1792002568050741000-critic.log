     1  """
     2  Crossover analysis: find the size where insertion sort becomes >10x slower
     3  than builtin_sorted for each input type.
     4  
     5  Hypothesis (from experiment_002):
     6    The large gap at n=4096 suggests insertion sort becomes impractical well
     7    before that size. We expect the crossover (10x slowdown) to occur at
     8    different sizes depending on input type:
     9    - sorted: lowest crossover (insertion sort benefits from O(n) best case)
    10    - random: medium crossover
    11    - duplicates: medium crossover (many equal elements reduce comparisons)
    12    - reverse: highest crossover (insertion sort worst case O(n²))
    13  
    14  Design:
    15  - Sizes: 8, 16, 32, 64, 128, 256, 512, 1024 (factor-2 steps)
    16  - Input types: random, sorted, reverse, duplicates (all four)
    17  - Repetitions: 100 per condition
    18  - Deterministic seeds (same as experiment_001)
    19  - Correctness verified on every measured input
    20  - Measurement order randomized
    21  - Copying NOT timed (copy happens before timing starts)
    22  """
    23  import csv
    24  import os
    25  import platform
    26  import random
    27  import sys
    28  import time
    29  from collections import defaultdict
    30  
    31  
    32  # ---------------------------------------------------------------------------
    33  # Algorithms
    34  # ---------------------------------------------------------------------------
    35  
    36  def insertion_sort(arr):
    37      """Pure-Python insertion sort. Returns a new sorted list."""
    38      a = list(arr)
    39      n = len(a)
    40      for i in range(1, n):
    41          key = a[i]
    42          j = i - 1
    43          while j >= 0 and a[j] > key:
    44              a[j + 1] = a[j]
    45              j -= 1
    46          a[j + 1] = key
    47      return a
    48  
    49  
    50  # ---------------------------------------------------------------------------
    51  # Input generation
    52  # ---------------------------------------------------------------------------
    53  
    54  def generate_input(itype, size, seed):
    55      """Generate a list of integers. Returns the list."""
    56      rng = random.Random(seed)
    57      if itype == "random":
    58          return [rng.randint(-1000, 1000) for _ in range(size)]
    59      elif itype == "sorted":
    60          return sorted([rng.randint(-1000, 1000) for _ in range(size)])
    61      elif itype == "reverse":
    62          return sorted([rng.randint(-1000, 1000) for _ in range(size)], reverse=True)
    63      elif itype == "duplicates":
    64          return [rng.randint(0, 3) for _ in range(size)]
    65      else:
    66          raise ValueError(f"Unknown input type: {itype}")
    67  
    68  
    69  # ---------------------------------------------------------------------------
    70  # Benchmarking
    71  # ---------------------------------------------------------------------------
    72  
    73  def benchmark_one(algo_fn, data, reps):
    74      """Run reps measurements for one algorithm on one input.
    75      Returns list of elapsed times in seconds."""
    76      times = []
    77      for _ in range(reps):
    78          # Copy input BEFORE timing starts -- copy is NOT timed
    79          data_copy = list(data)
    80          start = time.perf_counter()
    81          result = algo_fn(data_copy)
    82          end = time.perf_counter()
    83          times.append(end - start)
    84      return times
