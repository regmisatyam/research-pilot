   277                      cv = std / mean * 100 if mean > 0 else 0
   278                      if cv < best_cv:
   279                          best_cv = cv
   280                          best_n = number
   281          print(f"  size={size}: best N={best_n} (CV={best_cv:.1f}%)")
   282  
   283      print()
   284      print("=" * 100)
   285      print("RATIO ANALYSIS: insertion_sort / builtin_sorted (per-call time)")
   286      print("=" * 100)
   287      print()
   288  
   289      # Only compare at shared N values
   290      shared_numbers = sorted(set(all_numbers_builtin) & set(all_numbers_insert))
   291      for size in sizes:
   292          for itype in input_types:
   293              for number in shared_numbers:
   294                  b_key = (size, itype, "builtin_sorted", number)
   295                  i_key = (size, itype, "insertion_sort", number)
   296                  if b_key in groups and i_key in groups:
   297                      b_mean = sum(groups[b_key]) / len(groups[b_key])
   298                      i_mean = sum(groups[i_key]) / len(groups[i_key])
   299                      ratio = i_mean / b_mean if b_mean > 0 else float("inf")
   300                      print(
   301                          f"  size={size:3d} {itype:15s} N={number:4d}: ratio={ratio:7.2f}x"
   302                      )
   303  
   304      print()
   305      print("Note: timeit module handles repeated calls. number=N means N calls per repeat.")
   306      print("Copying is NOT timed; only the sort operation is measured.")
   307      print("Measurement order was randomized to reduce systematic bias.")
   308  
   309      return csv_path
   310  
   311  
   312  if __name__ == "__main__":
   313      csv_path = run_benchmark()
   314      print()
   315      print(f"Done. Re-run verification: python3 {os.path.join(os.path.dirname(__file__), 'verify_timeit_number.py')} {csv_path}")


