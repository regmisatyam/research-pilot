   140              if result != expected:
   141                  print(f"ERROR: {algo_name} failed correctness on size={size} type={itype}")
   142                  sys.exit(1)
   143  
   144          for algo_name in algo_map:
   145              times = benchmark_one(algo_map[algo_name], data, reps)
   146              for i, t in enumerate(times):
   147                  all_rows.append({
