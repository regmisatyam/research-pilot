   121      print(f"Running {reps} repetitions per condition...")
   122      print(f"Total conditions: {len(conditions)} × 2 algorithms = {len(conditions) * 2}")
   123      print(f"Total measurements: {len(conditions) * 2 * reps}")
   124      print()
