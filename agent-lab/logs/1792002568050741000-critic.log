   106      # number=N values: full range for builtin_sorted (fast, timer overhead matters),
   107      # reduced range for insertion_sort (slow, N=1000 would take too long)
   108      numbers_builtin = [1, 10, 100, 1000]
   109      numbers_insert = [1, 10, 100]
