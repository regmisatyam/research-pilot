     1  """
     2  Experiment 004: Timer resolution analysis and Timsort adaptive claim verification.
     3  
     4  Hypothesis (from experiment_001 data analysis):
     5    1. Timer resolution at small sizes (32) introduces quantization error for
     6       builtin_sorted (~208 ns resolution). Using timeit module should give
     7       more reliable results.
     8    2. The Timsort adaptive benefit grows with size (1.53x at n=32, 3.45x at n=128,
     9       5.55x at n=512), contradicting the "~2x" claim in experiment_001 report.
    10  
    11  Design:
    12  - Timer: timeit module (handles repeated calls, discards outliers)
    13  - Also run perf_counter for comparison
    14  - Sizes: 32, 128, 512 (same as experiment_001)
    15  - Input types: random, sorted, reverse, duplicates (all four)
    16  - Repetitions: 100 per condition (timeit default is 100000, we use 100)
    17  - Deterministic seeds (same as experiment_001)
    18  - Correctness verified on every measured input
    19  - Copying NOT timed (copy happens before timing starts)
    20  """
    21  import csv
    22  import os
    23  import platform
    24  import random
    25  import sys
    26  import time
    27  import timeit
    28  from collections import defaultdict
    29  
    30  
    31  # ---------------------------------------------------------------------------
    32  # Algorithms
    33  # ---------------------------------------------------------------------------
    34  
    35  def insertion_sort(arr):
    36      """Pure-Python insertion sort. Returns a new sorted list."""
    37      a = list(arr)
    38      n = len(a)
    39      for i in range(1, n):
    40          key = a[i]
    41          j = i - 1
    42          while j >= 0 and a[j] > key:
    43              a[j + 1] = a[j]
    44              j -= 1
    45          a[j + 1] = key
    46      return a
    47  
    48  
    49  # ---------------------------------------------------------------------------
    50  # Input generation
    51  # ---------------------------------------------------------------------------
    52  
    53  def generate_input(itype, size, seed):
    54      """Generate a list of integers. Returns the list."""
    55      rng = random.Random(seed)
    56      if itype == "random":
    57          return [rng.randint(-1000, 1000) for _ in range(size)]
    58      elif itype == "sorted":
    59          return sorted([rng.randint(-1000, 1000) for _ in range(size)])
    60      elif itype == "reverse":
    61          return sorted([rng.randint(-1000, 1000) for _ in range(size)], reverse=True)
    62      elif itype == "duplicates":
    63          return [rng.randint(0, 3) for _ in range(size)]
    64      else:
    65          raise ValueError(f"Unknown input type: {itype}")
    66  
    67  
    68  # ---------------------------------------------------------------------------
    69  # Benchmarking
    70  # ---------------------------------------------------------------------------
    71  
    72  def benchmark_perf_counter(algo_fn, data, reps):
    73      """Run reps measurements using time.perf_counter()."""
    74      times = []
    75      for _ in range(reps):
    76          data_copy = list(data)
    77          start = time.perf_counter()
    78          result = algo_fn(data_copy)
    79          end = time.perf_counter()
    80          times.append(end - start)
    81      return times
    82  
    83  
    84  def benchmark_timeit(algo_fn, data, reps):
    85      """Run reps measurements using timeit module."""
    86      # timeit.repeat runs the setup + stmt reps times each, returns list of total times
    87      # We use number=1 (one call per repeat) and reps repeats
    88      timer = timeit.default_timer
    89      times = timeit.repeat(
    90          stmt=lambda: algo_fn(list(data)),
    91          setup=lambda: None,
    92          number=1,
    93          repeat=reps,
    94          timer=timer,
    95      )
    96      return times
    97  
    98  
    99  def run_benchmark():
   100      # Platform info
   101      info = {
   102          "python_version": platform.python_version(),
   103          "python_implementation": platform.python_implementation(),
   104          "platform": platform.platform(),
   105          "machine": platform.machine(),
   106          "processor": platform.processor(),
   107      }
   108      print("Platform information:")
   109      for k, v in info.items():
   110          print(f"  {k}: {v}")
   111      print()
   112  
   113      # Parameters
   114      sizes = [32, 128, 512]
   115      input_types = ["random", "sorted", "reverse", "duplicates"]
   116      seeds = {"random": 42, "sorted": 1, "reverse": 1, "duplicates": 99}
   117      reps = 100  # repetitions per condition
   118  
   119      # Build all conditions
   120      conditions = []
   121      for size in sizes:
   122          for itype in input_types:
   123              seed = seeds[itype]
   124              data = generate_input(itype, size, seed)
   125              conditions.append((size, itype, seed, data))
   126  
   127      # Randomize measurement order
   128      rng_order = random.Random(12345)
   129      condition_indices = list(range(len(conditions)))
   130      rng_order.shuffle(condition_indices)
   131  
   132      # Run measurements
   133      print(f"Running {reps} repetitions per condition...")
   134      print(f"Total conditions: {len(conditions)} x 2 algorithms = {len(conditions) * 2}")
   135      print(f"Total measurements: {len(conditions) * 2 * reps}")
   136      print()
   137  
   138      all_rows = []
   139      algo_map = {
   140          "builtin_sorted": sorted,
   141          "insertion_sort": insertion_sort,
   142      }
   143  
   144      for idx in condition_indices:
   145          size, itype, seed, data = conditions[idx]
   146  
   147          # Verify correctness
   148          expected = sorted(data)
   149          for algo_name in algo_map:
   150              test_data = list(data)
   151              result = algo_map[algo_name](test_data)
   152              if result != expected:
   153                  print(f"ERROR: {algo_name} failed correctness on size={size} type={itype}")
   154                  sys.exit(1)
   155  
   156          for algo_name in algo_map:
   157              # Use timeit for more accurate timing
   158              times = benchmark_timeit(algo_map[algo_name], data, reps)
   159              for i, t in enumerate(times):
   160                  all_rows.append({
   161                      "size": size,
   162                      "input_type": itype,
   163                      "seed": seed,
   164                      "algorithm": algo_name,
   165                      "repetition": i,
   166                      "time_seconds": t,
   167                      "time_microseconds": t * 1e6,
   168                  })
   169  
   170      # Write raw CSV
   171      csv_path = os.path.join(os.path.dirname(__file__), "measurements.csv")
   172      fieldnames = list(all_rows[0].keys())
   173      with open(csv_path, "w", newline="") as f:
   174          writer = csv.DictWriter(f, fieldnames=fieldnames)
   175          writer.writeheader()
   176          writer.writerows(all_rows)
   177      print(f"Raw measurements written to: {csv_path}")
   178      print(f"  Rows: {len(all_rows)}")
   179      print(f"  File size: {os.path.getsize(csv_path)} bytes")
   180      print()
   181  
   182      # Summary statistics
   183      print("=" * 90)
   184      print("SUMMARY STATISTICS (microseconds) — timeit module")
   185      print("=" * 90)
   186  
   187      groups = defaultdict(list)
   188      for row in all_rows:
   189          key = (row["size"], row["input_type"], row["algorithm"])
   190          groups[key].append(row["time_microseconds"])
   191  
   192      for size in sizes:
   193          for itype in input_types:
   194              builtin_key = (size, itype, "builtin_sorted")
   195              insert_key = (size, itype, "insertion_sort")
   196              if builtin_key in groups and insert_key in groups:
   197                  b_times = groups[builtin_key]
   198                  i_times = groups[insert_key]
   199                  b_mean = sum(b_times) / len(b_times)
   200                  i_mean = sum(i_times) / len(i_times)
   201                  b_std = (sum((x - b_mean) ** 2 for x in b_times) / len(b_times)) ** 0.5
   202                  i_std = (sum((x - i_mean) ** 2 for x in i_times) / len(i_times)) ** 0.5
   203                  b_cv = b_std / b_mean * 100 if b_mean > 0 else 0
   204                  i_cv = i_std / i_mean * 100 if i_mean > 0 else 0
   205                  ratio = i_mean / b_mean if b_mean > 0 else float("inf")
   206                  print(
   207                      f"  size={size:3d} {itype:15s}  "
   208                      f"builtin:  {b_mean:8.2f} +/- {b_std:6.2f} ({b_cv:5.1f}%)  "
   209                      f"insert:   {i_mean:8.2f} +/- {i_std:6.2f} ({i_cv:5.1f}%)  "
   210                      f"ratio: {ratio:6.2f}x"
   211                  )
   212  
   213      print()
   214      print("=" * 90)
   215      print("Timsort ADAPTIVE CLAIM VERIFICATION")
   216      print("Ratio of random/sorted time for builtin_sorted (should be >1 if adaptive)")
   217      print("=" * 90)
   218  
   219      for size in sizes:
   220          s_mean = sum(groups[(size, "sorted", "builtin_sorted")]) / len(groups[(size, "sorted", "builtin_sorted")])
   221          r_mean = sum(groups[(size, "random", "builtin_sorted")]) / len(groups[(size, "random", "builtin_sorted")])
   222          ratio = r_mean / s_mean if s_mean > 0 else float("inf")
   223          print(f"  size={size}: sorted={s_mean:7.2f} random={r_mean:7.2f} ratio={ratio:5.2f}x")
   224  
   225      print()
   226      print("Note: timeit module handles repeated calls and is more accurate for fast operations.")
   227      print("Copying is NOT timed; only the sort operation is measured.")
   228      print("Measurement order was randomized to reduce systematic bias.")
   229  
