     1  """
     2  Main benchmarking script: sorted() vs insertion_sort() for small integer lists.
     3  
     4  Design decisions:
     5  - Timer: time.perf_counter() (highest resolution available)
     6  - Copying: NOT timed. Each sort receives a fresh copy of the input data.
     7    The copy happens BEFORE timing starts, so we measure sorting only.
     8  - Randomization: Measurement order is randomized to avoid systematic bias
     9    (CPU frequency scaling, background processes, thermal throttling).
    10  - Repetitions: 50 per condition (exceeds the 30 minimum).
    11  - Conditions: 3 sizes × 4 input types × 2 algorithms = 24 conditions.
    12  - Deterministic seeds recorded for every input generation.
    13  - Correctness verified on every measured input before timing.
    14  """
    15  import csv
    16  import os
    17  import platform
    18  import random
    19  import sys
    20  import time
    21  from collections import defaultdict
    22  
    23  # ---------------------------------------------------------------------------
    24  # Algorithms
    25  # ---------------------------------------------------------------------------
    26  
    27  def insertion_sort(arr):
    28      """Pure-Python insertion sort. Returns a new sorted list."""
    29      a = list(arr)
    30      n = len(a)
    31      for i in range(1, n):
    32          key = a[i]
    33          j = i - 1
    34          while j >= 0 and a[j] > key:
    35              a[j + 1] = a[j]
    36              j -= 1
    37          a[j + 1] = key
    38      return a
    39  
    40  
    41  # ---------------------------------------------------------------------------
    42  # Input generation
    43  # ---------------------------------------------------------------------------
    44  
    45  def generate_input(itype, size, seed):
    46      """Generate a list of integers. Returns the list."""
    47      rng = random.Random(seed)
    48      if itype == "random":
    49          return [rng.randint(-1000, 1000) for _ in range(size)]
    50      elif itype == "sorted":
    51          return sorted([rng.randint(-1000, 1000) for _ in range(size)])
    52      elif itype == "reverse":
    53          return sorted([rng.randint(-1000, 1000) for _ in range(size)], reverse=True)
    54      elif itype == "duplicates":
    55          return [rng.randint(0, 3) for _ in range(size)]
    56      else:
    57          raise ValueError(f"Unknown input type: {itype}")
    58  
    59  
    60  # ---------------------------------------------------------------------------
    61  # Benchmarking
    62  # ---------------------------------------------------------------------------
    63  
    64  def benchmark_one(algo_name, data, reps):
    65      """Run reps measurements for one algorithm on one input.
    66      Returns list of elapsed times in seconds."""
    67      times = []
    68      for _ in range(reps):
    69          # Copy input BEFORE timing starts -- copy is NOT timed
    70          data_copy = list(data)
    71          start = time.perf_counter()
    72          result = algo_name(data_copy)
    73          end = time.perf_counter()
    74          times.append(end - start)
    75      return times
