   134                  sys.exit(1)
   135  
   136          for algo_name in algo_names:
   137              times = benchmark_one(algo_map[algo_name], data, reps)
   138              for i, t in enumerate(times):
   139                  all_rows.append({
   140                      "size": size,
   141                      "input_type": itype,
   142                      "seed": seed,
   143                      "algorithm": algo_name,
   144                      "repetition": i,
   145                      "time_seconds": t,
   146                      "time_microseconds": t * 1e6,
   147                  })
   148  
   149      # Write raw CSV
   150      csv_path = os.path.join(os.path.dirname(__file__), "measurements.csv")
   151      fieldnames = list(all_rows[0].keys())
   152      with open(csv_path, "w", newline="") as f:
   153          writer = csv.DictWriter(f, fieldnames=fieldnames)
   154          writer.writeheader()
   155          writer.writerows(all_rows)
   156      print(f"Raw measurements written to: {csv_path}")
   157      print(f"  Rows: {len(all_rows)}")
   158      print(f"  File size: {os.path.getsize(csv_path)} bytes")
   159      print()
   160  
   161      # Summary statistics
   162      print("=" * 70)
   163      print("SUMMARY STATISTICS (microseconds)")
   164      print("=" * 70)
   165  
   166      # Group by (size, input_type, algorithm)
   167      groups = defaultdict(list)
   168      for row in all_rows:
   169          key = (row["size"], row["input_type"], row["algorithm"])
   170          groups[key].append(row["time_microseconds"])
   171  
   172      for size in sizes:
   173          for itype in input_types:
   174              builtin_key = (size, itype, "builtin_sorted")
   175              insert_key = (size, itype, "insertion_sort")
   176              if builtin_key in groups and insert_key in groups:
   177                  b_times = groups[builtin_key]
   178                  i_times = groups[insert_key]
   179                  b_mean = sum(b_times) / len(b_times)
   180                  i_mean = sum(i_times) / len(i_times)
   181                  b_std = (sum((x - b_mean) ** 2 for x in b_times) / len(b_times)) ** 0.5
   182                  i_std = (sum((x - i_mean) ** 2 for x in i_times) / len(i_times)) ** 0.5
   183                  ratio = i_mean / b_mean if b_mean > 0 else float("inf")
   184                  print(
   185                      f"  size={size:3d} {itype:15s}  "
   186                      f"builtin:  {b_mean:8.2f} ± {b_std:6.2f} μs  "
   187                      f"insert:   {i_mean:8.2f} ± {i_std:6.2f} μs  "
   188                      f"ratio(i/b): {ratio:6.2f}x"
   189                  )
   190  
   191      print()
   192      print("Note: ratio > 1 means insertion_sort is slower than builtin_sorted.")
   193      print("Copying is NOT timed; only the sort operation is measured.")
   194      print("Measurement order was randomized to reduce systematic bias.")
   195  
   196      return csv_path
   197  
   198  
   199  if __name__ == "__main__":
   200      csv_path = run_benchmark()
   201      print()
