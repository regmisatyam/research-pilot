    94      input_types = ["random", "sorted", "reverse", "duplicates"]
    95      seeds = {"random": 42, "sorted": 1, "reverse": 1, "duplicates": 99}
    96      reps = 50  # repetitions per condition
    97  
    98      # Build all conditions
    99      conditions = []
   100      for size in sizes:
   101          for itype in input_types:
   102              seed = seeds[itype]
   103              data = generate_input(itype, size, seed)
   104              conditions.append((size, itype, seed, data))
   105  
   106      # Randomize measurement order (shuffle conditions)
   107      rng_order = random.Random(12345)  # fixed seed for reproducibility of order
   108      condition_indices = list(range(len(conditions)))
   109      rng_order.shuffle(condition_indices)
   110  
   111      # Run measurements
   112      print(f"Running {reps} repetitions per condition...")
   113      print(f"Total conditions: {len(conditions)} × 2 algorithms = {len(conditions) * 2}")
   114      print(f"Total measurements: {len(conditions) * 2 * reps}")
   115      print()
   116  
   117      all_rows = []
   118      algo_map = {
   119          "builtin_sorted": sorted,
   120          "insertion_sort": insertion_sort,
   121      }
   122      algo_names = list(algo_map.keys())
   123  
   124      for idx in condition_indices:
   125          size, itype, seed, data = conditions[idx]
   126  
   127          # Verify correctness before timing
   128          expected = sorted(data)
   129          for algo_name in algo_names:
   130              test_data = list(data)
   131              result = algo_map[algo_name](test_data)
   132              if result != expected:
   133                  print(f"ERROR: {algo_name} failed correctness on size={size} type={itype}")
   134                  sys.exit(1)
   135  
   136          for algo_name in algo_names:
   137              times = benchmark_one(algo_map[algo_name], data, reps)
   138              for i, t in enumerate(times):
   139                  all_rows.append({
   140                      "size": size,
   141                      "input_type": itype,
   142                      "seed": seed,
   143                      "algorithm": algo_name,
   144                      "repetition": i,
   145                      "time_seconds": t,
   146                      "time_microseconds": t * 1e6,
   147                  })
   148  
   149      # Write raw CSV
   150      csv_path = os.path.join(os.path.dirname(__file__), "measurements.csv")
   151      fieldnames = list(all_rows[0].keys())
   152      with open(csv_path, "w", newline="") as f:
   153          writer = csv.DictWriter(f, fieldnames=fieldnames)
