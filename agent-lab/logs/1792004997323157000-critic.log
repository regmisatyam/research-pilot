     1  """
     2  Main benchmarking script: sorted() vs insertion_sort() for small integer lists.
     3  
     4  Design decisions:
     5  - Timer: time.perf_counter() (highest resolution available)
     6  - Copying: NOT timed. Each sort receives a fresh copy of the input data.
     7    The copy happens BEFORE timing starts, so we measure sorting only.
     8  - Randomization: Measurement order is randomized to avoid systematic bias
     9    (CPU frequency scaling, background processes, thermal throttling).
    10  - Repetitions: 50 per condition (exceeds the 30 minimum).
    11  - Conditions: 3 sizes × 4 input types × 2 algorithms = 24 conditions.
    12  - Deterministic seeds recorded for every input generation.
    13  - Correctness verified on every measured input before timing.
    14  """
    15  import csv
    16  import os
    17  import platform
    18  import random
    19  import sys
    20  import time
    21  from collections import defaultdict
    22  
    23  # ---------------------------------------------------------------------------
    24  # Algorithms
    25  # ---------------------------------------------------------------------------
    26  
    27  def insertion_sort(arr):
    28      """Pure-Python insertion sort. Returns a new sorted list."""
    29      a = list(arr)
    30      n = len(a)
    31      for i in range(1, n):
    32          key = a[i]
    33          j = i - 1
    34          while j >= 0 and a[j] > key:
    35              a[j + 1] = a[j]
    36              j -= 1
    37          a[j + 1] = key
    38      return a
    39  
    40  
    41  # ---------------------------------------------------------------------------
    42  # Input generation
    43  # ---------------------------------------------------------------------------
    44  
    45  def generate_input(itype, size, seed):
    46      """Generate a list of integers. Returns the list."""
    47      rng = random.Random(seed)
    48      if itype == "random":
    49          return [rng.randint(-1000, 1000) for _ in range(size)]
    50      elif itype == "sorted":
    51          return sorted([rng.randint(-1000, 1000) for _ in range(size)])
    52      elif itype == "reverse":
    53          return sorted([rng.randint(-1000, 1000) for _ in range(size)], reverse=True)
    54      elif itype == "duplicates":
    55          return [rng.randint(0, 3) for _ in range(size)]
    56      else:
    57          raise ValueError(f"Unknown input type: {itype}")
    58  
    59  
    60  # ---------------------------------------------------------------------------
    61  # Benchmarking
    62  # ---------------------------------------------------------------------------
    63  
    64  def benchmark_one(algo_name, data, reps):
    65      """Run reps measurements for one algorithm on one input.
    66      Returns list of elapsed times in seconds."""
    67      times = []
    68      for _ in range(reps):
    69          # Copy input BEFORE timing starts -- copy is NOT timed
    70          data_copy = list(data)
    71          start = time.perf_counter()
    72          result = algo_name(data_copy)
    73          end = time.perf_counter()
    74          times.append(end - start)
    75      return times
    76  
    77  
    78  def run_benchmark():
    79      # Platform info
    80      info = {
    81          "python_version": platform.python_version(),
    82          "python_implementation": platform.python_implementation(),
    83          "platform": platform.platform(),
    84          "machine": platform.machine(),
    85          "processor": platform.processor(),
    86      }
    87      print("Platform information:")
    88      for k, v in info.items():
    89          print(f"  {k}: {v}")
    90      print()
    91  
    92      # Parameters
    93      sizes = [32, 128, 512]
    94      input_types = ["random", "sorted", "reverse", "duplicates"]
    95      seeds = {"random": 42, "sorted": 1, "reverse": 1, "duplicates": 99}
    96      reps = 50  # repetitions per condition
    97  
    98      # Build all conditions
    99      conditions = []
   100      for size in sizes:
   101          for itype in input_types:
   102              seed = seeds[itype]
   103              data = generate_input(itype, size, seed)
   104              conditions.append((size, itype, seed, data))
   105  
   106      # Randomize measurement order (shuffle conditions)
   107      rng_order = random.Random(12345)  # fixed seed for reproducibility of order
   108      condition_indices = list(range(len(conditions)))
   109      rng_order.shuffle(condition_indices)
   110  
   111      # Run measurements
   112      print(f"Running {reps} repetitions per condition...")
   113      print(f"Total conditions: {len(conditions)} × 2 algorithms = {len(conditions) * 2}")
   114      print(f"Total measurements: {len(conditions) * 2 * reps}")
   115      print()
   116  
   117      all_rows = []
   118      algo_map = {
   119          "builtin_sorted": sorted,
   120          "insertion_sort": insertion_sort,
   121      }
   122      algo_names = list(algo_map.keys())
   123  
   124      for idx in condition_indices:
   125          size, itype, seed, data = conditions[idx]
   126  
   127          # Verify correctness before timing
   128          expected = sorted(data)
   129          for algo_name in algo_names:
   130              test_data = list(data)
   131              result = algo_map[algo_name](test_data)
   132              if result != expected:
   133                  print(f"ERROR: {algo_name} failed correctness on size={size} type={itype}")
   134                  sys.exit(1)
   135  
   136          for algo_name in algo_names:
   137              times = benchmark_one(algo_map[algo_name], data, reps)
   138              for i, t in enumerate(times):
   139                  all_rows.append({
   140                      "size": size,
   141                      "input_type": itype,
   142                      "seed": seed,
   143                      "algorithm": algo_name,
   144                      "repetition": i,
   145                      "time_seconds": t,
   146                      "time_microseconds": t * 1e6,
   147                  })
   148  
   149      # Write raw CSV
   150      csv_path = os.path.join(os.path.dirname(__file__), "measurements.csv")
   151      fieldnames = list(all_rows[0].keys())
   152      with open(csv_path, "w", newline="") as f:
   153          writer = csv.DictWriter(f, fieldnames=fieldnames)
   154          writer.writeheader()
   155          writer.writerows(all_rows)
   156      print(f"Raw measurements written to: {csv_path}")
   157      print(f"  Rows: {len(all_rows)}")
   158      print(f"  File size: {os.path.getsize(csv_path)} bytes")
   159      print()
   160  
   161      # Summary statistics
   162      print("=" * 70)
   163      print("SUMMARY STATISTICS (microseconds)")
   164      print("=" * 70)
   165  
   166      # Group by (size, input_type, algorithm)
   167      groups = defaultdict(list)
   168      for row in all_rows:
   169          key = (row["size"], row["input_type"], row["algorithm"])
   170          groups[key].append(row["time_microseconds"])
   171  
   172      for size in sizes:
   173          for itype in input_types:
   174              builtin_key = (size, itype, "builtin_sorted")
   175              insert_key = (size, itype, "insertion_sort")
   176              if builtin_key in groups and insert_key in groups:
   177                  b_times = groups[builtin_key]
   178                  i_times = groups[insert_key]
   179                  b_mean = sum(b_times) / len(b_times)
   180                  i_mean = sum(i_times) / len(i_times)
   181                  b_std = (sum((x - b_mean) ** 2 for x in b_times) / len(b_times)) ** 0.5
   182                  i_std = (sum((x - i_mean) ** 2 for x in i_times) / len(i_times)) ** 0.5
   183                  ratio = i_mean / b_mean if b_mean > 0 else float("inf")
   184                  print(
   185                      f"  size={size:3d} {itype:15s}  "
   186                      f"builtin:  {b_mean:8.2f} ± {b_std:6.2f} μs  "
   187                      f"insert:   {i_mean:8.2f} ± {i_std:6.2f} μs  "
   188                      f"ratio(i/b): {ratio:6.2f}x"
   189                  )
   190  
   191      print()
   192      print("Note: ratio > 1 means insertion_sort is slower than builtin_sorted.")
   193      print("Copying is NOT timed; only the sort operation is measured.")
   194      print("Measurement order was randomized to reduce systematic bias.")
   195  
   196      return csv_path
   197  
   198  
   199  if __name__ == "__main__":
   200      csv_path = run_benchmark()
   201      print()
