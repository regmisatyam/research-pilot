     1  """
     2  Experiment 008: Partially Sorted Inputs — Follow-up to Experiment 001/003
     3  
     4  Hypothesis:
     5    For partially sorted inputs (where k% of elements are out of order),
     6    insertion sort will perform proportionally better than on random input,
     7    and the performance gap with sorted() will be smaller than on random
     8    input but larger than on fully sorted input. The gap should scale
     9    roughly linearly with the disorder percentage.
    10  
    11  Design:
    12    - Sizes: 32, 128, 512 (same as experiment_001)
    13    - Disorder levels: 0% (sorted), 10%, 25%, 50%, 75%, 100% (random)
    14    - Disorder method: Fisher-Yates shuffle of k% of elements in a sorted list
    15    - Repetitions: 50 per condition (same as experiment_001)
    16    - Timer: time.perf_counter()
    17    - Copying: NOT timed
    18    - Randomization: measurement order randomized (seed 12345)
    19    - Seeds: disorder=42, sorted=1, random=42
    20    - Correctness: verified on every measured input
    21  """
    22  import csv
    23  import os
    24  import platform
    25  import random
    26  import sys
    27  import time
    28  from collections import defaultdict
    29  
    30  
    31  def insertion_sort(arr):
    32      """Pure-Python insertion sort. Returns a new sorted list."""
    33      a = list(arr)
    34      n = len(a)
    35      for i in range(1, n):
    36          key = a[i]
    37          j = i - 1
    38          while j >= 0 and a[j] > key:
    39              a[j + 1] = a[j]
    40              j -= 1
    41          a[j + 1] = key
    42      return a
    43  
    44  
    45  def generate_partially_sorted(size, disorder_pct, seed):
    46      """Generate a sorted list, then shuffle disorder_pct% of elements.
    47  
    48      disorder_pct=0 -> fully sorted
    49      disorder_pct=100 -> random permutation (not random values)
    50      """
    51      rng = random.Random(seed)
    52      # Start with sorted values
    53      data = list(range(size))
    54      # Shuffle disorder_pct% of elements
    55      k = int(size * disorder_pct / 100.0)
    56      if k > 0:
    57          indices = list(range(size))
    58          rng.shuffle(indices)
    59          # Swap k random pairs
    60          for i in range(k):
    61              idx_a = indices[i]
    62              idx_b = indices[rng.randint(0, size - 1)]
    63              data[idx_a], data[idx_b] = data[idx_b], data[idx_a]
    64      return data
    65  
    66  
    67  def generate_random(size, seed):
    68      """Generate random integers in [-1000, 1000]."""
    69      rng = random.Random(seed)
    70      return [rng.randint(-1000, 1000) for _ in range(size)]
    71  
    72  
    73  def benchmark_one(algo_name, data, reps):
    74      """Run reps measurements for one algorithm on one input."""
    75      times = []
    76      for _ in range(reps):
    77          data_copy = list(data)
    78          start = time.perf_counter()
    79          result = algo_name(data_copy)
    80          end = time.perf_counter()
    81          times.append(end - start)
    82      return times
    83  
    84  
    85  def run_benchmark():
    86      info = {
    87          "python_version": platform.python_version(),
    88          "python_implementation": platform.python_implementation(),
    89          "platform": platform.platform(),
    90          "machine": platform.machine(),
    91          "processor": platform.processor(),
    92      }
    93      print("Platform information:")
    94      for k, v in info.items():
    95          print(f"  {k}: {v}")
    96      print()
    97  
    98      sizes = [32, 128, 512]
    99      disorder_levels = [0, 10, 25, 50, 75, 100]
   100      reps = 50
   101  
   102      print(f"Hypothesis: Partially sorted insertion sort scales linearly with disorder.")
   103      print(f"Disorder levels: {disorder_levels}%")
   104      print(f"Sizes: {sizes}")
   105      print(f"Repetitions: {reps}")
   106      print()
   107  
   108      # Build conditions
   109      conditions = []
   110      for size in sizes:
   111          for dpct in disorder_levels:
   112              if dpct == 0:
   113                  # Fully sorted
   114                  rng = random.Random(1)
   115                  data = sorted([rng.randint(-1000, 1000) for _ in range(size)])
   116              elif dpct == 100:
   117                  # Fully random
   118                  data = generate_random(size, 42)
   119              else:
   120                  data = generate_partially_sorted(size, dpct, 42)
   121              conditions.append((size, dpct, data))
   122  
   123      # Randomize measurement order
   124      rng_order = random.Random(12345)
   125      condition_indices = list(range(len(conditions)))
   126      rng_order.shuffle(condition_indices)
   127  
   128      print(f"Running {reps} repetitions per condition...")
   129      print(f"Total conditions: {len(conditions)} x 2 algorithms = {len(conditions) * 2}")
   130      print(f"Total measurements: {len(conditions) * 2 * reps}")
   131      print()
   132  
   133      all_rows = []
   134      algo_map = {
   135          "builtin_sorted": sorted,
   136          "insertion_sort": insertion_sort,
   137      }
   138      algo_names = list(algo_map.keys())
   139  
   140      for idx in condition_indices:
   141          size, dpct, data = conditions[idx]
   142  
   143          # Verify correctness
   144          expected = sorted(data)
   145          for algo_name in algo_names:
   146              test_data = list(data)
   147              result = algo_map[algo_name](test_data)
   148              if result != expected:
   149                  print(f"ERROR: {algo_name} failed correctness on size={size} disorder={dpct}%")
   150                  sys.exit(1)
   151  
   152          for algo_name in algo_names:
   153              times = benchmark_one(algo_map[algo_name], data, reps)
   154              for i, t in enumerate(times):
   155                  all_rows.append({
   156                      "size": size,
   157                      "disorder_pct": dpct,
   158                      "algorithm": algo_name,
   159                      "repetition": i,
   160                      "time_seconds": t,
   161                      "time_microseconds": t * 1e6,
   162                  })
   163  
   164      # Write raw CSV
   165      csv_path = os.path.join(os.path.dirname(__file__), "measurements.csv")
   166      fieldnames = list(all_rows[0].keys())
   167      with open(csv_path, "w", newline="") as f:
   168          writer = csv.DictWriter(f, fieldnames=fieldnames)
   169          writer.writeheader()
   170          writer.writerows(all_rows)
   171      print(f"Raw measurements written to: {csv_path}")
   172      print(f"  Rows: {len(all_rows)}")
   173      print(f"  File size: {os.path.getsize(csv_path)} bytes")
   174      print()
   175  
   176      # Summary statistics
   177      print("=" * 80)
   178      print("SUMMARY STATISTICS (microseconds)")
   179      print("=" * 80)
   180  
   181      groups = defaultdict(list)
   182      for row in all_rows:
   183          key = (row["size"], row["disorder_pct"], row["algorithm"])
   184          groups[key].append(row["time_microseconds"])
   185  
   186      for size in sizes:
   187          print(f"\n  Size = {size}")
   188          print(f"  {'Disorder':>10s}  {'Builtin':>10s}  {'Insertion':>10s}  {'Ratio':>8s}  {'B-CV':>6s}  {'I-CV':>6s}")
   189          for dpct in disorder_levels:
   190              b_key = (size, dpct, "builtin_sorted")
   191              i_key = (size, dpct, "insertion_sort")
   192              if b_key in groups and i_key in groups:
   193                  b_times = groups[b_key]
   194                  i_times = groups[i_key]
   195                  b_mean = sum(b_times) / len(b_times)
   196                  i_mean = sum(i_times) / len(i_times)
   197                  b_std = (sum((x - b_mean) ** 2 for x in b_times) / len(b_times)) ** 0.5
   198                  i_std = (sum((x - i_mean) ** 2 for x in i_times) / len(i_times)) ** 0.5
   199                  ratio = i_mean / b_mean if b_mean > 0 else float("inf")
   200                  b_cv = (b_std / b_mean * 100) if b_mean > 0 else 0
   201                  i_cv = (i_std / i_mean * 100) if i_mean > 0 else 0
   202                  print(f"  {dpct:>9}%  {b_mean:>10.2f}  {i_mean:>10.2f}  {ratio:>8.1f}x  {b_cv:>5.1f}%  {i_cv:>5.1f}%")
   203  
   204      print()
   205      print("Note: ratio > 1 means insertion_sort is slower than builtin_sorted.")
   206      print("Copying is NOT timed; only the sort operation is measured.")
   207      print("Disorder=0% = fully sorted, Disorder=100% = random values.")
   208      print("Measurement order was randomized to reduce systematic bias.")
   209  
   210      return csv_path
