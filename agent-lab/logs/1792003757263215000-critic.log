     1  """
     2  Verify report numbers from raw CSV data.
     3  Reads measurements.csv and prints summary statistics.
     4  Usage: python3 verify_from_csv.py [path_to_csv]
     5  """
     6  import csv
     7  import os
     8  import sys
     9  from collections import defaultdict
    10  
    11  
    12  def main():
    13      if len(sys.argv) > 1:
    14          csv_path = sys.argv[1]
    15      else:
    16          csv_path = os.path.join(os.path.dirname(__file__), "measurements.csv")
    17  
    18      if not os.path.exists(csv_path):
    19          print(f"ERROR: {csv_path} not found. Run benchmark.py first.")
    20          sys.exit(1)
    21  
    22      print(f"Verifying from: {csv_path}")
    23      print(f"File size: {os.path.getsize(csv_path)} bytes")
    24      print()
    25  
    26      # Read all rows
    27      with open(csv_path, "r") as f:
    28          reader = csv.DictReader(f)
    29          rows = list(reader)
    30  
    31      print(f"Total rows: {len(rows)}")
    32      print(f"Columns: {list(rows[0].keys())}")
    33      print()
    34  
    35      # Group by (size, input_type, algorithm)
    36      groups = defaultdict(list)
    37      for row in rows:
    38          key = (int(row["size"]), row["input_type"], row["algorithm"])
    39          groups[key].append(float(row["time_microseconds"]))
    40  
    41      sizes = sorted(set(k[0] for k in groups.keys()))
    42      input_types = sorted(set(k[1] for k in groups.keys()))
    43      algorithms = sorted(set(k[2] for k in groups.keys()))
    44  
    45      print("=" * 80)
    46      print("VERIFICATION: Summary Statistics from Raw CSV (microseconds)")
    47      print("=" * 80)
    48      print()
    49  
    50      for size in sizes:
    51          for itype in input_types:
    52              for algo in algorithms:
    53                  key = (size, itype, algo)
    54                  if key not in groups:
    55                      continue
    56                  times = groups[key]
    57                  n = len(times)
    58                  mean = sum(times) / n
    59                  variance = sum((x - mean) ** 2 for x in times) / n
    60                  std = variance ** 0.5
    61                  mn = min(times)
    62                  mx = max(times)
    63                  sorted_t = sorted(times)
    64                  median = sorted_t[n // 2]
    65                  if n % 2 == 0:
    66                      median = (sorted_t[n // 2 - 1] + sorted_t[n // 2]) / 2
    67  
    68                  print(
    69                      f"  size={size:3d} {itype:15s} {algo:18s}  "
    70                      f"n={n:3d}  mean={mean:8.2f}  std={std:6.2f}  "
    71                      f"median={median:8.2f}  min={mn:6.2f}  max={mx:6.2f}"
    72                  )
    73  
    74      print()
    75      print("=" * 80)
    76      print("Cross-algorithm ratios (insertion_sort / builtin_sorted)")
    77      print("=" * 80)
    78      print()
    79  
    80      for size in sizes:
    81          for itype in input_types:
    82              insert_key = (size, itype, "insertion_sort")
    83              builtin_key = (size, itype, "builtin_sorted")
    84              if insert_key in groups and builtin_key in groups:
    85                  i_mean = sum(groups[insert_key]) / len(groups[insert_key])
    86                  b_mean = sum(groups[builtin_key]) / len(groups[builtin_key])
    87                  ratio = i_mean / b_mean if b_mean > 0 else float("inf")
    88                  print(
    89                      f"  size={size:3d} {itype:15s}  ratio={ratio:6.2f}x  "
    90                      f"(insert={i_mean:8.2f} μs, builtin={b_mean:8.2f} μs)"
    91                  )
    92  
    93      print()
