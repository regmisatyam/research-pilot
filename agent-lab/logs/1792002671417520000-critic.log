   115      input_types = ["random", "sorted", "reverse", "duplicates"]
   116      seeds = {"random": 42, "sorted": 1, "reverse": 1, "duplicates": 99}
   117      reps = 100  # repetitions per condition
   118  
   119      # Build all conditions
   120      conditions = []
   121      for size in sizes:
   122          for itype in input_types:
   123              seed = seeds[itype]
   124              data = generate_input(itype, size, seed)
   125              conditions.append((size, itype, seed, data))
   126  
   127      # Randomize measurement order
   128      rng_order = random.Random(12345)
   129      condition_indices = list(range(len(conditions)))
   130      rng_order.shuffle(condition_indices)
   131  
   132      # Run measurements
   133      print(f"Running {reps} repetitions per condition...")
   134      print(f"Total conditions: {len(conditions)} x 2 algorithms = {len(conditions) * 2}")
   135      print(f"Total measurements: {len(conditions) * 2 * reps}")
   136      print()
   137  
   138      all_rows = []
   139      algo_map = {
   140          "builtin_sorted": sorted,
   141          "insertion_sort": insertion_sort,
   142      }
   143  
   144      for idx in condition_indices:
   145          size, itype, seed, data = conditions[idx]
   146  
   147          # Verify correctness
   148          expected = sorted(data)
   149          for algo_name in algo_map:
   150              test_data = list(data)
   151              result = algo_map[algo_name](test_data)
   152              if result != expected:
   153                  print(f"ERROR: {algo_name} failed correctness on size={size} type={itype}")
   154                  sys.exit(1)
   155  
   156          for algo_name in algo_map:
   157              # Use timeit for more accurate timing
   158              times = benchmark_timeit(algo_map[algo_name], data, reps)
   159              for i, t in enumerate(times):
   160                  all_rows.append({
   161                      "size": size,
   162                      "input_type": itype,
   163                      "seed": seed,
   164                      "algorithm": algo_name,
   165                      "repetition": i,
   166                      "time_seconds": t,
   167                      "time_microseconds": t * 1e6,
   168                  })
   169  
   170      # Write raw CSV
   171      csv_path = os.path.join(os.path.dirname(__file__), "measurements.csv")
   172      fieldnames = list(all_rows[0].keys())
   173      with open(csv_path, "w", newline="") as f:
   174          writer = csv.DictWriter(f, fieldnames=fieldnames)
   175          writer.writeheader()
   176          writer.writerows(all_rows)
   177      print(f"Raw measurements written to: {csv_path}")
   178      print(f"  Rows: {len(all_rows)}")
   179      print(f"  File size: {os.path.getsize(csv_path)} bytes")
   180      print()
   181  
   182      # Summary statistics
   183      print("=" * 90)
   184      print("SUMMARY STATISTICS (microseconds) — timeit module")
   185      print("=" * 90)
   186  
   187      groups = defaultdict(list)
   188      for row in all_rows:
   189          key = (row["size"], row["input_type"], row["algorithm"])
   190          groups[key].append(row["time_microseconds"])
   191  
   192      for size in sizes:
   193          for itype in input_types:
   194              builtin_key = (size, itype, "builtin_sorted")
   195              insert_key = (size, itype, "insertion_sort")
   196              if builtin_key in groups and insert_key in groups:
   197                  b_times = groups[builtin_key]
   198                  i_times = groups[insert_key]
   199                  b_mean = sum(b_times) / len(b_times)
   200                  i_mean = sum(i_times) / len(i_times)
   201                  b_std = (sum((x - b_mean) ** 2 for x in b_times) / len(b_times)) ** 0.5
   202                  i_std = (sum((x - i_mean) ** 2 for x in i_times) / len(i_times)) ** 0.5
   203                  b_cv = b_std / b_mean * 100 if b_mean > 0 else 0
   204                  i_cv = i_std / i_mean * 100 if i_mean > 0 else 0
   205                  ratio = i_mean / b_mean if b_mean > 0 else float("inf")
   206                  print(
   207                      f"  size={size:3d} {itype:15s}  "
   208                      f"builtin:  {b_mean:8.2f} +/- {b_std:6.2f} ({b_cv:5.1f}%)  "
   209                      f"insert:   {i_mean:8.2f} +/- {i_std:6.2f} ({i_cv:5.1f}%)  "
   210                      f"ratio: {ratio:6.2f}x"
   211                  )
   212  
   213      print()
   214      print("=" * 90)
   215      print("Timsort ADAPTIVE CLAIM VERIFICATION")
   216      print("Ratio of random/sorted time for builtin_sorted (should be >1 if adaptive)")
   217      print("=" * 90)
   218  
   219      for size in sizes:
