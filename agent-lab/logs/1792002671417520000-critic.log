    30  
    31  def insertion_sort(arr):
    32      """Pure-Python insertion sort. Returns a new sorted list."""
    33      a = list(arr)
    34      n = len(a)
    35      for i in range(1, n):
    36          key = a[i]
    37          j = i - 1
    38          while j >= 0 and a[j] > key:
    39              a[j + 1] = a[j]
    40              j -= 1
    41          a[j + 1] = key
    42      return a
    43  
    44  
    45  def generate_partially_sorted(size, disorder_pct, seed):
    46      """Generate a sorted list, then shuffle disorder_pct% of elements.
    47  
    48      disorder_pct=0 -> fully sorted
    49      disorder_pct=100 -> random permutation (not random values)
    50      """
    51      rng = random.Random(seed)
    52      # Start with sorted values
    53      data = list(range(size))
    54      # Shuffle disorder_pct% of elements
    55      k = int(size * disorder_pct / 100.0)
    56      if k > 0:
    57          indices = list(range(size))
    58          rng.shuffle(indices)
    59          # Swap k random pairs
    60          for i in range(k):
    61              idx_a = indices[i]
    62              idx_b = indices[rng.randint(0, size - 1)]
    63              data[idx_a], data[idx_b] = data[idx_b], data[idx_a]
    64      return data
    65  
    66  
    67  def generate_random(size, seed):
    68      """Generate random integers in [-1000, 1000]."""
    69      rng = random.Random(seed)
    70      return [rng.randint(-1000, 1000) for _ in range(size)]
