     1  """
     2  Experiment 004: Timer resolution analysis and Timsort adaptive claim verification.
     3  
     4  Hypothesis (from experiment_001 data analysis):
     5    1. Timer resolution at small sizes (32) introduces quantization error for
     6       builtin_sorted (~208 ns resolution). Using timeit module should give
     7       more reliable results.
     8    2. The Timsort adaptive benefit grows with size (1.53x at n=32, 3.45x at n=128,
     9       5.55x at n=512), contradicting the "~2x" claim in experiment_001 report.
    10  
    11  Design:
    12  - Timer: timeit module (handles repeated calls, discards outliers)
    13  - Also run perf_counter for comparison
    14  - Sizes: 32, 128, 512 (same as experiment_001)
    15  - Input types: random, sorted, reverse, duplicates (all four)
    16  - Repetitions: 100 per condition (timeit default is 100000, we use 100)
    17  - Deterministic seeds (same as experiment_001)
    18  - Correctness verified on every measured input
    19  - Copying NOT timed (copy happens before timing starts)
    20  """
    21  import csv
    22  import os
    23  import platform
    24  import random
    25  import sys
    26  import time
    27  import timeit
    28  from collections import defaultdict
    29  
    30  
    31  # ---------------------------------------------------------------------------
    32  # Algorithms
    33  # ---------------------------------------------------------------------------
    34  
    35  def insertion_sort(arr):
    36      """Pure-Python insertion sort. Returns a new sorted list."""
    37      a = list(arr)
    38      n = len(a)
    39      for i in range(1, n):
    40          key = a[i]
    41          j = i - 1
    42          while j >= 0 and a[j] > key:
    43              a[j + 1] = a[j]
    44              j -= 1
    45          a[j + 1] = key
    46      return a
    47  
    48  
    49  # ---------------------------------------------------------------------------
    50  # Input generation
    51  # ---------------------------------------------------------------------------
    52  
    53  def generate_input(itype, size, seed):
    54      """Generate a list of integers. Returns the list."""
    55      rng = random.Random(seed)
    56      if itype == "random":
    57          return [rng.randint(-1000, 1000) for _ in range(size)]
    58      elif itype == "sorted":
    59          return sorted([rng.randint(-1000, 1000) for _ in range(size)])
    60      elif itype == "reverse":
    61          return sorted([rng.randint(-1000, 1000) for _ in range(size)], reverse=True)
    62      elif itype == "duplicates":
    63          return [rng.randint(0, 3) for _ in range(size)]
    64      else:
    65          raise ValueError(f"Unknown input type: {itype}")
    66  
    67  
    68  # ---------------------------------------------------------------------------
    69  # Benchmarking
    70  # ---------------------------------------------------------------------------
    71  
    72  def benchmark_perf_counter(algo_fn, data, reps):
    73      """Run reps measurements using time.perf_counter()."""
    74      times = []
    75      for _ in range(reps):
    76          data_copy = list(data)
    77          start = time.perf_counter()
    78          result = algo_fn(data_copy)
    79          end = time.perf_counter()
    80          times.append(end - start)
    81      return times
    82  
    83  
    84  def benchmark_timeit(algo_fn, data, reps):
    85      """Run reps measurements using timeit module."""
    86      # timeit.repeat runs the setup + stmt reps times each, returns list of total times
    87      # We use number=1 (one call per repeat) and reps repeats
    88      timer = timeit.default_timer
    89      times = timeit.repeat(
    90          stmt=lambda: algo_fn(list(data)),
    91          setup=lambda: None,
    92          number=1,
    93          repeat=reps,
    94          timer=timer,
    95      )
    96      return times
    97  
    98  
    99  def run_benchmark():
   100      # Platform info
   101      info = {
   102          "python_version": platform.python_version(),
   103          "python_implementation": platform.python_implementation(),
   104          "platform": platform.platform(),
   105          "machine": platform.machine(),
