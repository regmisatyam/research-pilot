     1  """
     2  Experiment 007 — Discrepancy Investigation: timeit vs perf_counter for presorted inputs
     3  
     4  Hypothesis (from experiment_006):
     5    The large discrepancies (29-40%) between corrected timeit and perf_counter
     6    for presorted inputs at n=128/512 suggest that Timsort's adaptive behavior
     7    interacts differently with the two measurement approaches.
     8  
     9    Possible causes:
    10    1. GC effects — timeit's loop may trigger GC at different points
    11    2. Memory allocation — timeit's loop may cause different allocation patterns
    12    3. Timsort internal behavior — different code paths triggered by loop overhead
    13  
    14    Approach:
    15    - Measure builtin_sorted with both methods on identical inputs
    16    - Control GC with gc.collect() before each measurement
    17    - Track memory allocations with tracemalloc
    18    - Test with pre-allocated buffers
    19    - Test with frozen inputs (no copy needed)
    20  
    21    If the discrepancy disappears with gc.collect(), it's a GC effect.
    22    If it disappears with pre-allocated buffers, it's an allocation effect.
    23    If it persists, it's likely Timsort's internal behavior.
    24  """
    25  import csv
    26  import gc
    27  import os
    28  import sys
    29  import time
    30  import timeit
    31  import tracemalloc
    32  
    33  # ── Input generation ──────────────────────────────────────────────────────────
    34  
    35  def make_inputs(seed, size, input_type):
    36      """Generate a deterministic input list."""
    37      import random
    38      rng = random.Random(seed)
    39      if input_type == "random":
    40          return [rng.randint(-1000, 1000) for _ in range(size)]
    41      elif input_type == "sorted":
    42          return list(range(size))
    43      elif input_type == "reverse":
    44          return list(range(size, 0, -1))
    45      elif input_type == "duplicates":
    46          return [rng.randint(0, 3) for _ in range(size)]
    47      else:
    48          raise ValueError(f"Unknown input_type: {input_type}")
    49  
    50  
    51  # ── Measurement functions ─────────────────────────────────────────────────────
    52  
    53  def measure_perf_counter(data):
    54      """Measure sorted() with time.perf_counter. Returns (time_us, snapshot)."""
    55      tracemalloc.start()
    56      t0 = time.perf_counter()
    57      result = sorted(data)
    58      t1 = time.perf_counter()
    59      elapsed = t1 - t0
    60      snapshot = tracemalloc.get_traced_memory()
    61      tracemalloc.stop()
    62      return elapsed * 1e6, snapshot  # return microseconds
    63  
    64  
    65  def measure_timeit(data):
    66      """Measure sorted() with timeit.timeit. Returns (time_us, snapshot)."""
    67      tracemalloc.start()
    68      # timeit returns total time for N iterations; we use N=1
    69      elapsed = timeit.timeit(lambda: sorted(data), number=1)
    70      snapshot = tracemalloc.get_traced_memory()
    71      tracemalloc.stop()
    72      return elapsed * 1e6, snapshot  # return microseconds
    73  
    74  
    75  def measure_perf_counter_gc(data):
    76      """Measure sorted() with gc.collect() before and after."""
    77      gc.collect()
    78      tracemalloc.start()
    79      t0 = time.perf_counter()
    80      result = sorted(data)
    81      t1 = time.perf_counter()
    82      gc.collect()
    83      elapsed = t1 - t0
    84      snapshot = tracemalloc.get_traced_memory()
    85      tracemalloc.stop()
    86      return elapsed * 1e6, snapshot
    87  
    88  
    89  def measure_timeit_gc(data):
    90      """Measure sorted() with timeit and gc.collect()."""
    91      gc.collect()
    92      tracemalloc.start()
    93      elapsed = timeit.timeit(lambda: sorted(data), number=1)
    94      gc.collect()
    95      snapshot = tracemalloc.get_traced_memory()
    96      tracemalloc.stop()
    97      return elapsed * 1e6, snapshot
    98  
