   165          size, itype, data = conditions[idx]
   166  
   167          # Verify correctness
   168          expected = sorted(data)
   169          for algo_name in algo_map:
   170              test_data = list(data)
   171              result = algo_map[algo_name](test_data)
   172              if result != expected:
   173                  print(f"ERROR: {algo_name} failed correctness on size={size} type={itype}")
   174                  sys.exit(1)
   175  
   176          for algo_name in algo_map:
   177              for gc_mode in ["disabled", "enabled", "collect"]:
   178                  if gc_mode == "disabled":
   179                      times = benchmark_one_gc_disabled(algo_map[algo_name], data, reps)
   180                  elif gc_mode == "enabled":
   181                      times = benchmark_one_gc_enabled(algo_map[algo_name], data, reps)
   182                  elif gc_mode == "collect":
   183                      times = benchmark_one_gc_collect(algo_map[algo_name], data, reps)
   184  
   185                  for i, t in enumerate(times):
   186                      all_rows.append({
   187                          "size": size,
   188                          "input_type": itype,
   189                          "algorithm": algo_name,
   190                          "gc_mode": gc_mode,
   191                          "repetition": i,
   192                          "time_seconds": t,
   193                          "time_microseconds": t * 1e6,
   194                      })
   195  
   196      # Write raw CSV
   197      csv_path = os.path.join(os.path.dirname(__file__), "measurements.csv")
   198      fieldnames = list(all_rows[0].keys())
   199      with open(csv_path, "w", newline="") as f:
   200          writer = csv.DictWriter(f, fieldnames=fieldnames)
   201          writer.writeheader()
   202          writer.writerows(all_rows)
   203      print(f"Raw measurements written to: {csv_path}")
   204      print(f"  Rows: {len(all_rows)}")
   205      print(f"  File size: {os.path.getsize(csv_path)} bytes")
   206      print()
   207  
   208      # Summary statistics
   209      print("=" * 80)
   210      print("SUMMARY STATISTICS (microseconds)")
   211      print("=" * 80)
   212  
   213      groups = defaultdict(list)
   214      for row in all_rows:
   215          key = (row["size"], row["input_type"], row["algorithm"], row["gc_mode"])
   216          groups[key].append(row["time_microseconds"])
   217  
   218      for size in sizes:
   219          for itype in input_types:
   220              print(f"\n  Size={size}, Input={itype}")
   221              print(f"  {'GC Mode':>12s}  {'Algo':>15s}  {'Mean':>8s}  {'Median':>8s}  {'Std':>8s}  {'CV':>6s}  {'Min':>8s}  {'Max':>8s}  {'Outliers':>10s}")
   222              for algo_name in ["builtin_sorted", "insertion_sort"]:
   223                  for gc_mode in ["disabled", "enabled", "collect"]:
   224                      key = (size, itype, algo_name, gc_mode)
   225                      if key in groups:
   226                          times = groups[key]
   227                          mean_t = sum(times) / len(times)
   228                          sorted_t = sorted(times)
   229                          median_t = sorted_t[len(sorted_t) // 2]
   230                          std_t = (sum((x - mean_t) ** 2 for x in times) / len(times)) ** 0.5
   231                          cv_t = (std_t / mean_t * 100) if mean_t > 0 else 0
   232                          min_t = sorted_t[0]
   233                          max_t = sorted_t[-1]
   234                          # Outliers: values > 3× the median
   235                          iqr = sorted_t[int(len(sorted_t) * 0.75)] - sorted_t[int(len(sorted_t) * 0.25)]
   236                          upper_fence = sorted_t[int(len(sorted_t) * 0.75)] + 3 * iqr
   237                          outlier_count = sum(1 for t in times if t > upper_fence)
   238                          print(f"  {gc_mode:>12s}  {algo_name:>15s}  {mean_t:>8.2f}  {median_t:>8.2f}  {std_t:>8.2f}  {cv_t:>5.1f}%  {min_t:>8.2f}  {max_t:>8.2f}  {outlier_count:>10d}")
   239  
   240      print()
   241      print("Outliers defined as values > Q3 + 3×IQR.")
   242      print("Copying is NOT timed; only the sort operation is measured.")
   243      print("GC disabled means gc.disable() before the loop, gc.enable() after.")
   244      print("GC collect means gc.collect() before each individual measurement.")
   245  
   246      return csv_path
   247  
   248  
   249  if __name__ == "__main__":
   250      csv_path = run_benchmark()
   251      print()
   252      print(f"Done. Re-run: python3 {os.path.join(os.path.dirname(__file__), 'verify_gc_outliers.py')} {csv_path}")


