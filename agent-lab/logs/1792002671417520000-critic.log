   221          r_mean = sum(groups[(size, "random", "builtin_sorted")]) / len(groups[(size, "random", "builtin_sorted")])
   222          ratio = r_mean / s_mean if s_mean > 0 else float("inf")
   223          print(f"  size={size}: sorted={s_mean:7.2f} random={r_mean:7.2f} ratio={ratio:5.2f}x")
