   230      print("For O(n²) scaling with factor-4 size increase: expected ratio ≈ 16×")
   231      print("For O(n) scaling with factor-4 size increase: expected ratio ≈ 4×")
   232      print("Copying is NOT timed; only the sort operation is measured.")
