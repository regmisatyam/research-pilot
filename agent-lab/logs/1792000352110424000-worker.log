     8  4. Recompute summary statistics from corrected data
     9  """
    10  import csv
    11  import os
    12  import sys
    13  
    14  
    15  def load_csv(path):
    16      with open(path, "r") as f:
    17          return list(csv.DictReader(f))
    18  
    19  
    20  def main():
    21      if len(sys.argv) < 2:
    22          print(f"Usage: {sys.argv[0]} <corrected_times.csv>")
    23          sys.exit(1)
    24  
    25      csv_path = sys.argv[1]
    26      if not os.path.exists(csv_path):
    27          print(f"ERROR: {csv_path} not found.")
    28          sys.exit(1)
    29  
    30      rows = load_csv(csv_path)
    31      print(f"Read {len(rows)} rows from {csv_path}")
    32      print()
    33  
    34      # Check R² values
    35      print("--- Model fit quality ---")
    36      all_r2 = [float(r["r_squared"]) for r in rows]
    37      min_r2 = min(all_r2)
    38      max_r2 = max(all_r2)
    39      mean_r2 = sum(all_r2) / len(all_r2)
    40      print(f"  R² range: {min_r2:.4f} – {max_r2:.4f}")
    41      print(f"  R² mean:  {mean_r2:.4f}")
    42  
    43      low_r2 = sum(1 for r in all_r2 if r < 0.90)
    44      if low_r2 > 0:
    45          print(f"  WARNING: {low_r2} conditions with R² < 0.90")
    46          for r in rows:
    47              if float(r["r_squared"]) < 0.90:
    48                  print(f"    size={r['size']} {r['input_type']} {r['algorithm']} R²={r['r_squared']}")
    49      else:
    50          print(f"  All conditions have R² ≥ 0.90 ✓")
    51  
    52      # Check true times are positive
    53      print()
    54      print("--- True time values ---")
    55      all_times = [float(r["true_time_us"]) for r in rows]
    56      min_time = min(all_times)
    57      max_time = max(all_times)
    58      print(f"  True time range: {min_time:.3f} – {max_time:.3f} μs")
    59      if min_time <= 0:
    60          print(f"  ERROR: Non-positive true time found!")
    61          for r in rows:
    62              if float(r["true_time_us"]) <= 0:
    63                  print(f"    size={r['size']} {r['input_type']} {r['algorithm']}")
    64      else:
    65          print(f"  All true times positive ✓")
    66  
    67      # Check overhead values
    68      print()
    69      print("--- Overhead values ---")
    70      all_overhead = [float(r["overhead_us"]) for r in rows]
    71      min_oh = min(all_overhead)
    72      max_oh = max(all_overhead)
    73      print(f"  Overhead range: {min_oh:.3f} – {max_oh:.3f} μs")
    74      if min_oh < 0:
    75          print(f"  WARNING: Negative overhead found (model may not fit)")
    76          for r in rows:
    77              if float(r["overhead_us"]) < 0:
    78                  print(f"    size={r['size']} {r['input_type']} {r['algorithm']}")
    79      else:
    80          print(f"  All overheads positive ✓ (N=1 overestimates)")
    81  
    82      # Summary by algorithm
    83      print()
    84      print("--- Summary by algorithm ---")
    85      algo_times = {}
    86      for r in rows:
    87          algo = r["algorithm"]
    88          if algo not in algo_times:
    89              algo_times[algo] = []
    90          algo_times[algo].append(float(r["true_time_us"]))
    91  
    92      for algo in sorted(algo_times):
    93          times = algo_times[algo]
    94          mean_t = sum(times) / len(times)
    95          min_t = min(times)
    96          max_t = max(times)
    97          print(f"  {algo}: mean={mean_t:.3f} μs  min={min_t:.3f} μs  max={max_t:.3f} μs  n={len(times)}")
    98  
    99      # Recompute ratios from corrected data
   100      print()
   101      print("--- Corrected ratios (insertion_sort / builtin_sorted) ---")
   102      lookup = {}
   103      for r in rows:
   104          key = (int(r["size"]), r["input_type"], r["algorithm"])
   105          lookup[key] = float(r["true_time_us"])
