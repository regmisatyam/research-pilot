     1  """
     2  Experiment 006 — Timer Overhead Bias Quantification and Correction
     3  
     4  Hypothesis (from experiment_005):
     5    The timeit-measured per-call time follows the model:
     6      measured_time(N) = true_time + overhead/N
     7    where overhead is the fixed timeit overhead per repeat. By measuring at
     8    multiple N values and fitting this model, we can estimate the true time
     9    (overhead→0) and the overhead itself.
    10  
    11    This is a linear model in 1/N:
    12      measured_time = true_time + overhead × (1/N)
    13  
    14    We fit this model to experiment_005 data and extrapolate to N=∞ (1/N=0)
    15    to get corrected times. We then compare corrected times with experiment_001
    16    (perf_counter) measurements.
    17  
    18  Design:
    19  - Uses experiment_005 data (already collected)
    20  - Fits linear model: time = a + b*(1/N) via least squares
    21  - Extrapolates to N=∞ for corrected times
    22  - Compares corrected times with experiment_001 perf_counter results
    23  - Validates model by checking R² and residual patterns
    24  - Python standard library only
    25  """
    26  import csv
    27  import os
    28  import sys
    29  from collections import defaultdict
    30  
    31  
    32  def load_csv(path):
    33      """Load CSV and return list of dicts."""
    34      with open(path, "r") as f:
    35          return list(csv.DictReader(f))
    36  
    37  
    38  def linear_regression(x, y):
    39      """Simple least-squares linear regression: y = a + b*x.
    40      Returns (a, b, r_squared)."""
    41      n = len(x)
    42      if n < 2:
    43          return None, None, None
    44  
    45      sum_x = sum(x)
    46      sum_y = sum(y)
    47      sum_xy = sum(xi * yi for xi, yi in zip(x, y))
    48      sum_x2 = sum(xi * xi for xi in x)
    49  
    50      denom = n * sum_x2 - sum_x * sum_x
    51      if denom == 0:
    52          return None, None, None
    53  
    54      b = (n * sum_xy - sum_x * sum_y) / denom
    55      a = (sum_y - b * sum_x) / n
    56  
    57      # R²
    58      mean_y = sum_y / n
    59      ss_tot = sum((yi - mean_y) ** 2 for yi in y)
    60      ss_res = sum((yi - (a + b * xi)) ** 2 for xi, yi in zip(x, y))
    61      r_squared = 1 - ss_res / ss_tot if ss_tot > 0 else 0
    62  
    63      return a, b, r_squared
    64  
    65  
    66  def run_analysis():
    67      # Look for experiment_005 data
    68      csv_path = os.path.join(os.path.dirname(__file__), "..", "experiment_005", "measurements.csv")
    69      if not os.path.exists(csv_path):
    70          print(f"ERROR: {csv_path} not found. Run experiment_005 first.")
    71          sys.exit(1)
    72  
    73      rows = load_csv(csv_path)
    74      print(f"Loaded {len(rows)} rows from experiment_005")
    75  
    76      # Platform info (from experiment_005)
    77      print()
    78      print("Platform: Python 3.13.15 / aarch64 Linux (from experiment_005)")
    79      print()
    80  
    81      # Group by (size, input_type, algorithm, N) and compute mean/std
    82      groups = defaultdict(list)
    83      for row in rows:
    84          key = (int(row["size"]), row["input_type"], row["algorithm"], int(row["number"]))
    85          t = float(row["time_microseconds"])
    86          groups[key].append(t)
    87  
    88      # Aggregate: mean and std per N within each condition
    89      aggregated = defaultdict(list)
    90      for (size, itype, algo, n), times in groups.items():
    91          mean_t = sum(times) / len(times)
    92          std_t = (sum((x - mean_t) ** 2 for x in times) / len(times)) ** 0.5
    93          aggregated[(size, itype, algo)].append((n, mean_t, std_t, len(times)))
    94  
    95      print("=" * 100)
    96      print("TIMER OVERHEAD BIAS MODEL: measured_time(N) = true_time + overhead/N")
    97      print("=" * 100)
    98      print()
    99      print("Note: Model fitted to MEANS within each N group (not individual points).")
   100      print("This reduces within-group noise and reveals the systematic trend.")
