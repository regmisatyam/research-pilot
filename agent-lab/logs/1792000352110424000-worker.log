\"perf_counter\")\n                t_key = (size, itype, seed, \"timeit\")\n                if p_key in groups and t_key in groups:\n                    p = groups[p_key][\"mean_us\"]\n                    t = groups[t_key][\"mean_us\"]\n                    disc = (t - p) / p * 100 if p > 0 else 0\n                    all_discrepancies.append(disc)\n         
