   172          groups[key].append(row["time_microseconds"])
   173  
   174      for size in sizes:
   175          for itype in input_types:
   176              builtin_key = (size, itype, "builtin_sorted")
   177              insert_key = (size, itype, "insertion_sort")
   178              if builtin_key in groups and insert_key in groups:
   179                  b_times = groups[builtin_key]
   180                  i_times = groups[insert_key]
   181                  b_mean = sum(b_times) / len(b_times)
   182                  i_mean = sum(i_times) / len(i_times)
   183                  b_std = (sum((x - b_mean) ** 2 for x in b_times) / len(b_times)) ** 0.5
   184                  i_std = (sum((x - i_mean) ** 2 for x in i_times) / len(i_times)) ** 0.5
