import csv
from collections import defaultdict

# Read experiment_001 data
with open('experiment_001/measurements.csv') as f:
    rows = list(csv.DictReader(f))

groups = defaultdict(list)
for row in rows:
    key = (int(row['size']), row['input_type'], row['algorithm'])
    groups[key].append(float(row['time_microseconds']))

print('=== Checking Timsort adaptive claim (~2x faster on sorted vs random) ===')
for size in [32, 128, 512]:
    for itype in ['sorted', 'random']:
        key = (size, itype, 'builtin_sorted')
        times = groups[key]
        mean = sum(times)/len(times)
        cv = (sum((x-mean)**2 for x in times)/len(times))**0.5 / mean * 100
        print(f'  size={size} {itype:10s} builtin: mean={mean:7.2f} std={sum((x-mean)**2 for x in times)/len(times)**0.5:6.2f} CV={cv:.1f}%')

print()
print('=== Checking sorted vs random ratio for builtin_sorted ===')
for size in [32, 128, 512]:
    s_mean = sum(groups[(size, 'sorted', 'builtin_sorted')])/50
    r_mean = sum(groups[(size, 'random', 'builtin_sorted')])/50
    print(f'  size={size}: sorted={s_mean:.2f} random={r_mean:.2f} ratio={r_mean/s_mean:.2f}x')

print()
print('=== Checking std for sorted input (high CV at size=32?) ===')
for size in [32, 128, 512]:
    key = (size, 'sorted', 'builtin_sorted')
    times = groups[key]
    mean = sum(times)/len(times)
    std = (sum((x-mean)**2 for x in times)/len(times))**0.5
    print(f'  size={size}: times={sorted(times)[:5]} ... {sorted(times)[-5:]}  mean={mean:.2f} std={std:.2f}')
"


