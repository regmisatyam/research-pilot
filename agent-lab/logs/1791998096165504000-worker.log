   121      algo_map = {
   122          "builtin_sorted": sorted,
   123          "insertion_sort": insertion_sort,
   124      }
   125  
   126      for idx in condition_indices:
   127          size, itype, seed, data = conditions[idx]
   128  
   129          # Verify correctness before timing
   130          expected = sorted(data)
   131          for algo_name in algo_map:
   132              test_data = list(data)
