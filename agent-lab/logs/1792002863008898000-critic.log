     1  """
     2  Scaling analysis: sorted() vs insertion_sort() at sizes 16, 64, 256, 1024, 4096.
     3  
     4  Hypothesis (from experiment_001 follow-up):
     5    - Reverse-sorted insertion sort scales as O(n²):
     6      ratio of ~16× between consecutive sizes (factor-4 increase → 4² = 16×).
     7    - Sorted insertion sort scales as O(n):
     8      ratio of ~4× between consecutive sizes (factor-4 increase → 4¹ = 4×).
     9    - sorted() (Timsort) scales close to O(n) for both:
    10      ratio of ~4× between consecutive sizes.
    11  
    12  Design:
    13  - Sizes: 16, 64, 256, 1024, 4096 (factor-4 steps)
    14  - Input types: sorted, reverse-sorted (the two extremes)
    15  - Repetitions: 100 per condition
    16  - Deterministic seeds recorded
    17  - Correctness verified on every measured input
    18  - Measurement order randomized
    19  - Copying NOT timed (copy happens before timing starts)
    20  """
    21  import csv
    22  import os
    23  import platform
    24  import random
    25  import sys
    26  import time
    27  from collections import defaultdict
    28  
    29  
    30  # ---------------------------------------------------------------------------
    31  # Algorithms
    32  # ---------------------------------------------------------------------------
    33  
    34  def insertion_sort(arr):
    35      """Pure-Python insertion sort. Returns a new sorted list."""
    36      a = list(arr)
    37      n = len(a)
    38      for i in range(1, n):
    39          key = a[i]
    40          j = i - 1
    41          while j >= 0 and a[j] > key:
    42              a[j + 1] = a[j]
    43              j -= 1
    44          a[j + 1] = key
    45      return a
    46  
    47  
    48  # ---------------------------------------------------------------------------
    49  # Input generation
    50  # ---------------------------------------------------------------------------
    51  
    52  def generate_input(itype, size, seed):
    53      """Generate a list of integers. Returns the list."""
    54      rng = random.Random(seed)
    55      if itype == "sorted":
    56          return sorted([rng.randint(-1000, 1000) for _ in range(size)])
    57      elif itype == "reverse":
    58          return sorted([rng.randint(-1000, 1000) for _ in range(size)], reverse=True)
    59      else:
    60          raise ValueError(f"Unknown input type: {itype}")
    61  
    62  
    63  # ---------------------------------------------------------------------------
    64  # Benchmarking
    65  # ---------------------------------------------------------------------------
    66  
    67  def benchmark_one(algo_fn, data, reps):
    68      """Run reps measurements for one algorithm on one input.
    69      Returns list of elapsed times in seconds."""
    70      times = []
    71      for _ in range(reps):
    72          # Copy input BEFORE timing starts -- copy is NOT timed
    73          data_copy = list(data)
    74          start = time.perf_counter()
    75          result = algo_fn(data_copy)
    76          end = time.perf_counter()
    77          times.append(end - start)
    78      return times
    79  
    80  
    81  def run_benchmark():
    82      # Platform info
    83      info = {
    84          "python_version": platform.python_version(),
    85          "python_implementation": platform.python_implementation(),
    86          "platform": platform.platform(),
    87          "machine": platform.machine(),
    88          "processor": platform.processor(),
    89      }
    90      print("Platform information:")
    91      for k, v in info.items():
    92          print(f"  {k}: {v}")
    93      print()
    94  
    95      # Parameters
    96      sizes = [16, 64, 256, 1024, 4096]
    97      input_types = ["sorted", "reverse"]
    98      seeds = {"sorted": 1, "reverse": 1}
    99      reps = 100  # repetitions per condition
   100  
   101      # Build all conditions
   102      conditions = []
   103      for size in sizes:
   104          for itype in input_types:
   105              seed = seeds[itype]
   106              data = generate_input(itype, size, seed)
   107              conditions.append((size, itype, seed, data))
   108  
   109      # Randomize measurement order (shuffle conditions)
   110      rng_order = random.Random(12345)  # fixed seed for reproducibility of order
   111      condition_indices = list(range(len(conditions)))
   112      rng_order.shuffle(condition_indices)
   113  
   114      # Run measurements
   115      print(f"Running {reps} repetitions per condition...")
   116      print(f"Total conditions: {len(conditions)} × 2 algorithms = {len(conditions) * 2}")
   117      print(f"Total measurements: {len(conditions) * 2 * reps}")
   118      print()
   119  
   120      all_rows = []
   121      algo_map = {
   122          "builtin_sorted": sorted,
   123          "insertion_sort": insertion_sort,
   124      }
   125  
   126      for idx in condition_indices:
   127          size, itype, seed, data = conditions[idx]
   128  
   129          # Verify correctness before timing
   130          expected = sorted(data)
   131          for algo_name in algo_map:
   132              test_data = list(data)
   133              result = algo_map[algo_name](test_data)
   134              if result != expected:
   135                  print(f"ERROR: {algo_name} failed correctness on size={size} type={itype}")
   136                  sys.exit(1)
   137  
   138          for algo_name in algo_map:
   139              times = benchmark_one(algo_map[algo_name], data, reps)
   140              for i, t in enumerate(times):
   141                  all_rows.append({
   142                      "size": size,
   143                      "input_type": itype,
   144                      "seed": seed,
   145                      "algorithm": algo_name,
   146                      "repetition": i,
   147                      "time_seconds": t,
   148                      "time_microseconds": t * 1e6,
   149                  })
   150  
   151      # Write raw CSV
   152      csv_path = os.path.join(os.path.dirname(__file__), "measurements.csv")
   153      fieldnames = list(all_rows[0].keys())
   154      with open(csv_path, "w", newline="") as f:
   155          writer = csv.DictWriter(f, fieldnames=fieldnames)
   156          writer.writeheader()
   157          writer.writerows(all_rows)
   158      print(f"Raw measurements written to: {csv_path}")
   159      print(f"  Rows: {len(all_rows)}")
   160      print(f"  File size: {os.path.getsize(csv_path)} bytes")
   161      print()
   162  
   163      # Summary statistics
   164      print("=" * 80)
   165      print("SUMMARY STATISTICS (microseconds)")
   166      print("=" * 80)
   167  
   168      # Group by (size, input_type, algorithm)
   169      groups = defaultdict(list)
   170      for row in all_rows:
   171          key = (row["size"], row["input_type"], row["algorithm"])
   172          groups[key].append(row["time_microseconds"])
   173  
   174      for size in sizes:
   175          for itype in input_types:
   176              builtin_key = (size, itype, "builtin_sorted")
   177              insert_key = (size, itype, "insertion_sort")
   178              if builtin_key in groups and insert_key in groups:
   179                  b_times = groups[builtin_key]
   180                  i_times = groups[insert_key]
   181                  b_mean = sum(b_times) / len(b_times)
   182                  i_mean = sum(i_times) / len(i_times)
   183                  b_std = (sum((x - b_mean) ** 2 for x in b_times) / len(b_times)) ** 0.5
   184                  i_std = (sum((x - i_mean) ** 2 for x in i_times) / len(i_times)) ** 0.5
   185                  ratio = i_mean / b_mean if b_mean > 0 else float("inf")
   186                  print(
   187                      f"  size={size:4d} {itype:10s}  "
   188                      f"builtin:  {b_mean:10.2f} ± {b_std:8.2f} μs  "
   189                      f"insert:   {i_mean:10.2f} ± {i_std:8.2f} μs  "
   190                      f"ratio(i/b): {ratio:8.2f}x"
   191                  )
   192  
   193      print()
   194      print("=" * 80)
   195      print("SCALING RATIOS (mean time / mean time at previous size)")
   196      print("=" * 80)
   197  
   198      # Compute scaling ratios between consecutive sizes
   199      for itype in input_types:
   200          print(f"\n  Input type: {itype}")
   201          print(f"  {'Algorithm':20s}  ", end="")
   202          for i, s in enumerate(sizes):
