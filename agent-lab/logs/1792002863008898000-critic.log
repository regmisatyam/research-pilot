import csv
from collections import defaultdict

# Verify experiment_001 report numbers from raw CSV
rows = list(csv.DictReader('/evidence/experiment_001/measurements.csv'))
print(f'Total rows: {len(rows)}')

groups = defaultdict(list)
for row in rows:
    key = (int(row['size']), row['input_type'], row['algorithm'])
    groups[key].append(float(row['time_microseconds']))

# Compare with report table
report_table = {
    (32, 'random', 'builtin_sorted'): (0.37, 0.02),
    (32, 'sorted', 'builtin_sorted'): (0.24, 0.09),
    (32, 'reverse', 'builtin_sorted'): (0.26, 0.07),
    (32, 'duplicates', 'builtin_sorted'): (0.32, 0.03),
    (128, 'random', 'builtin_sorted'): (1.91, 0.68),
    (128, 'sorted', 'builtin_sorted'): (0.55, 0.02),
    (128, 'reverse', 'builtin_sorted'): (0.70, 0.13),
    (128, 'duplicates', 'builtin_sorted'): (1.49, 0.16),
    (512, 'random', 'builtin_sorted'): (10.00, 0.63),
    (512, 'sorted', 'builtin_sorted'): (1.80, 0.09),
    (512, 'reverse', 'builtin_sorted'): (2.34, 0.03),
    (512, 'duplicates', 'builtin_sorted'): (9.04, 2.33),
}

print()
print('VERIFICATION: Report mean ± std vs CSV')
all_match = True
for key, (report_mean, report_std) in sorted(report_table.items()):
    times = groups[key]
    n = len(times)
    mean = sum(times) / n
    std = (sum((x - mean)**2 for x in times) / n) ** 0.5
    mean_ok = abs(mean - report_mean) / report_mean < 0.02
    std_ok = abs(std - report_std) / report_std < 0.05
    status = 'OK' if mean_ok and std_ok else 'MISMATCH'
    if status == 'MISMATCH':
        all_match = False
    print(f'  {key}: report={report_mean:.2f}±{report_std:.2f} csv={mean:.2f}±{std:.2f} [{status}]')

print(f'\nAll match: {all_match}')
"


